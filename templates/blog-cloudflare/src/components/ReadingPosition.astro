---
/**
 * Banner "Voce parou aqui — continuar?" no topo do post.
 *
 * Padrao explicito (nao auto-scroll silencioso): leitor 55+ valoriza
 * previsibilidade. Se o usuario clicar "Continuar", scrolla suavemente
 * pro ponto onde parou. Se dispensar, limpa o marcador.
 *
 * Persistencia: localStorage por slug. Salva {percent, timestamp} a
 * cada ~4s sem rolar. Mostra banner apenas se:
 *  - posicao entre 5% e 90% (nem comeco-comeco, nem ja-acabou)
 *  - ultima visita ha pelo menos 2min (e nao na mesma sessao)
 *  - ultima visita ha no maximo 30 dias (entao nao e mais relevante)
 *
 * Respeita prefers-reduced-motion automaticamente via theme.css que
 * seta scroll-behavior: auto no media query.
 *
 * Fase 8 a11y (~/.claude/plans/synthetic-imagining-storm.md).
 */
---

<div
	class="reading-position-banner"
	data-reading-position
	hidden
	role="region"
	aria-label="Continuar leitura"
>
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="reading-position-icon">
		<path d="M3 3h18v2H3z"></path>
		<path d="M3 21h18v-2H3z"></path>
		<path d="M3 11h11"></path>
		<path d="M3 15h7"></path>
		<path d="M18 8l4 4-4 4"></path>
	</svg>
	<span class="reading-position-text">
		<strong>Voce parou aqui na ultima visita.</strong>
		<small data-reading-position-when></small>
	</span>
	<button type="button" class="reading-position-continue" data-reading-position-continue>
		Continuar leitura
	</button>
	<button type="button" class="reading-position-dismiss" data-reading-position-dismiss aria-label="Dispensar">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<line x1="18" y1="6" x2="6" y2="18"></line>
			<line x1="6" y1="6" x2="18" y2="18"></line>
		</svg>
	</button>
</div>

<script>
	(function () {
		const KEY_PREFIX = "reading-pos:";
		const VERSION = "v1";
		const SAVE_DEBOUNCE_MS = 4000;
		const MIN_GAP_MS = 2 * 60 * 1000;       // 2 min entre visitas
		const MAX_AGE_MS = 30 * 24 * 3600 * 1000; // 30 dias
		const MIN_PERCENT = 0.05;
		const MAX_PERCENT = 0.90;

		// Slug = ultimo segmento de /posts/<slug> (Astro.url path apos rewrite)
		const m = location.pathname.match(/\/posts\/([^/?#]+)/);
		const slug = m ? m[1] : null;
		if (!slug) return;

		const article = document.querySelector<HTMLElement>(".article-content");
		const banner = document.querySelector<HTMLElement>("[data-reading-position]");
		if (!article || !banner) return;

		const continueBtn = banner.querySelector<HTMLButtonElement>("[data-reading-position-continue]");
		const dismissBtn = banner.querySelector<HTMLButtonElement>("[data-reading-position-dismiss]");
		const whenEl = banner.querySelector<HTMLElement>("[data-reading-position-when]");

		const storageKey = KEY_PREFIX + slug;

		function readPos(): { p: number; t: number } | null {
			try {
				const raw = localStorage.getItem(storageKey);
				if (!raw) return null;
				const data = JSON.parse(raw);
				if (data.v !== VERSION || typeof data.p !== "number" || typeof data.t !== "number") return null;
				if (Date.now() - data.t > MAX_AGE_MS) {
					localStorage.removeItem(storageKey);
					return null;
				}
				return data;
			} catch {
				return null;
			}
		}

		function writePos(percent: number) {
			try {
				localStorage.setItem(
					storageKey,
					JSON.stringify({ v: VERSION, p: percent, t: Date.now() })
				);
			} catch { /* quota / private mode — ignora */ }
		}

		function clearPos() {
			try { localStorage.removeItem(storageKey); } catch {}
		}

		function getCurrentPercent(): number {
			const rect = article.getBoundingClientRect();
			const articleHeight = article.offsetHeight;
			const viewportHeight = window.innerHeight;
			const scrollable = articleHeight - viewportHeight;
			if (scrollable <= 0) return 0;
			const scrolled = -rect.top;
			return Math.max(0, Math.min(1, scrolled / scrollable));
		}

		function scrollToPercent(percent: number) {
			const articleHeight = article.offsetHeight;
			const viewportHeight = window.innerHeight;
			const scrollable = articleHeight - viewportHeight;
			if (scrollable <= 0) return;
			const articleAbsTop = article.getBoundingClientRect().top + window.scrollY;
			window.scrollTo({ top: articleAbsTop + scrollable * percent, behavior: "smooth" });
		}

		function formatTimeSince(ms: number): string {
			const minutes = Math.floor(ms / 60000);
			if (minutes < 60) return `Ha ${minutes} min`;
			const hours = Math.floor(minutes / 60);
			if (hours < 24) return `Ha ${hours} h`;
			const days = Math.floor(hours / 24);
			if (days === 1) return "Ontem";
			if (days < 7) return `Ha ${days} dias`;
			const weeks = Math.floor(days / 7);
			if (weeks === 1) return "Ha 1 semana";
			return `Ha ${weeks} semanas`;
		}

		// === 1. Mostra banner se ha posicao salva valida ===
		const saved = readPos();
		const gap = saved ? Date.now() - saved.t : 0;
		if (saved && saved.p >= MIN_PERCENT && saved.p <= MAX_PERCENT && gap >= MIN_GAP_MS) {
			if (whenEl) whenEl.textContent = formatTimeSince(gap) + ` · ${Math.round(saved.p * 100)}% lido`;
			banner.hidden = false;
			continueBtn?.addEventListener("click", () => {
				scrollToPercent(saved.p);
				banner.hidden = true;
			});
			dismissBtn?.addEventListener("click", () => {
				banner.hidden = true;
				clearPos();
			});
		}

		// === 2. Salva posicao ao rolar (debounced) ===
		let saveTimer: ReturnType<typeof setTimeout> | undefined;
		function onScroll() {
			if (saveTimer) clearTimeout(saveTimer);
			saveTimer = setTimeout(() => {
				const p = getCurrentPercent();
				if (p >= MAX_PERCENT) {
					clearPos(); // considerado lido
				} else if (p >= MIN_PERCENT) {
					writePos(p);
				}
			}, SAVE_DEBOUNCE_MS);
		}
		window.addEventListener("scroll", onScroll, { passive: true });

		// Salva tambem ao sair (capture rapido antes da pagina sumir)
		window.addEventListener("pagehide", () => {
			const p = getCurrentPercent();
			if (p >= MIN_PERCENT && p < MAX_PERCENT) writePos(p);
		}, { capture: true });
	})();
</script>

<style>
	.reading-position-banner {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		padding: var(--spacing-3) var(--spacing-4);
		margin: var(--spacing-4) 0 var(--spacing-2);
		background: var(--color-bg-subtle);
		border-left: 3px solid var(--color-accent);
		border-radius: var(--radius-lg);
	}

	.reading-position-banner[hidden] {
		display: none;
	}

	.reading-position-icon {
		flex-shrink: 0;
		color: var(--color-accent);
	}

	.reading-position-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		flex: 1;
		line-height: var(--leading-snug);
		min-width: 0;
	}

	.reading-position-text strong {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
	}

	.reading-position-text small {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.reading-position-continue {
		padding: var(--spacing-2) var(--spacing-4);
		min-height: 44px;
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: none;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		cursor: pointer;
		transition: background var(--transition-fast);
		flex-shrink: 0;
	}

	.reading-position-continue:hover,
	.reading-position-continue:focus-visible {
		background: var(--color-accent-hover);
		outline: none;
	}

	.reading-position-dismiss {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		padding: 0;
		background: transparent;
		color: var(--color-muted);
		border: none;
		border-radius: 50%;
		cursor: pointer;
		transition: background var(--transition-fast), color var(--transition-fast);
		flex-shrink: 0;
	}

	.reading-position-dismiss:hover,
	.reading-position-dismiss:focus-visible {
		background: var(--color-surface);
		color: var(--color-text);
		outline: none;
	}

	@media (max-width: 600px) {
		.reading-position-banner {
			flex-wrap: wrap;
			padding: var(--spacing-3);
		}
		.reading-position-text {
			flex: 1 1 calc(100% - 60px);
		}
		.reading-position-continue {
			flex: 1 1 100%;
			order: 3;
			min-width: 0;
		}
	}
</style>
