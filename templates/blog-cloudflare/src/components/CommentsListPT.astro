---
/**
 * Lista de comentários, versão Douravita (PT-BR + visual do tema).
 *
 * Substitui o <Comments> do EmDash. Reusa `getComments()` do core pra ler
 * direto do D1 (sem chamada HTTP). Hoje renderiza nome + iniciais coloridas
 * no lugar do avatar pra TODOS — na Fase 5 vamos mostrar avatar do Facebook
 * pra leitores logados.
 *
 * Suporta thread de 1 nível (comment + replies). O EmDash já controla:
 * - Quais comments aparecem (status='approved' apenas)
 * - Moderação first_time (1º comment do email fica pending)
 * - Janela de tempo (comments_closed_after_days=90)
 */
import { getComments } from "emdash";

type Comment = {
	id: string;
	parentId: string | null;
	authorName: string;
	isRegisteredUser: boolean;
	body: string;
	createdAt: string;
	replies?: Comment[];
};

interface Props {
	collection: string;
	contentId: string;
	threaded?: boolean;
	class?: string;
}

const { collection, contentId, threaded = true, class: className } = Astro.props;

const { items, total } = await getComments({ collection, contentId, threaded });

const URL_RE = /https?:\/\/[^\s<>"')\]]+/g;
const AMP_RE = /&/g;
const LT_RE = /</g;
const GT_RE = />/g;
const QUOT_RE = /"/g;

function escapeHtml(text: string): string {
	return text
		.replace(AMP_RE, "&amp;")
		.replace(LT_RE, "&lt;")
		.replace(GT_RE, "&gt;")
		.replace(QUOT_RE, "&quot;");
}

function autoLinkUrls(text: string): string {
	return text.replace(
		URL_RE,
		(url) => `<a href="${url}" rel="nofollow ugc noopener" target="_blank">${url}</a>`,
	);
}

function formatBody(text: string): string {
	return autoLinkUrls(escapeHtml(text));
}

function initials(name: string): string {
	const parts = name.trim().split(/\s+/).filter(Boolean);
	if (parts.length === 0) return "?";
	if (parts.length === 1) return parts[0]!.slice(0, 2).toUpperCase();
	return (parts[0]![0] + parts[parts.length - 1]![0]).toUpperCase();
}

// Cor estável por nome — hash simples (não cripto, só visual).
function avatarColor(name: string): string {
	let hash = 0;
	for (let i = 0; i < name.length; i++) {
		hash = (hash * 31 + name.charCodeAt(i)) >>> 0;
	}
	const hue = hash % 360;
	return `hsl(${hue}, 42%, 52%)`;
}

function formatDate(iso: string): string {
	const d = new Date(iso);
	return d.toLocaleDateString("pt-BR", {
		day: "2-digit",
		month: "long",
		year: "numeric",
	});
}

function headingLabel(total: number): string {
	if (total === 0) return "Seja o primeiro a comentar";
	if (total === 1) return "1 comentário";
	return `${total} comentários`;
}
---

<section
	class:list={["dv-comments", className]}
	data-dv-comments
	data-collection={collection}
	data-content-id={contentId}
>
	<h3 class="dv-comments-heading">{headingLabel(total)}</h3>

	{items.length > 0 && (
		<ol class="dv-comments-list">
			{items.map((comment: Comment) => (
				<li>
					<article class="dv-comment" id={`comment-${comment.id}`}>
						<header class="dv-comment-header">
							<span
								class="dv-comment-avatar"
								style={`background:${avatarColor(comment.authorName)}`}
								aria-hidden="true"
							>
								{initials(comment.authorName)}
							</span>
							<div class="dv-comment-meta">
								<span class="dv-comment-author">{comment.authorName}</span>
								<time class="dv-comment-date" datetime={comment.createdAt}>
									{formatDate(comment.createdAt)}
								</time>
							</div>
						</header>
						<div class="dv-comment-body" set:html={formatBody(comment.body)} />

						{threaded && comment.replies && comment.replies.length > 0 && (
							<ol class="dv-comment-replies">
								{comment.replies.map((reply: Comment) => (
									<li>
										<article class="dv-comment dv-comment-reply" id={`comment-${reply.id}`}>
											<header class="dv-comment-header">
												<span
													class="dv-comment-avatar dv-comment-avatar--sm"
													style={`background:${avatarColor(reply.authorName)}`}
													aria-hidden="true"
												>
													{initials(reply.authorName)}
												</span>
												<div class="dv-comment-meta">
													<span class="dv-comment-author">{reply.authorName}</span>
													<time class="dv-comment-date" datetime={reply.createdAt}>
														{formatDate(reply.createdAt)}
													</time>
												</div>
											</header>
											<div class="dv-comment-body" set:html={formatBody(reply.body)} />
										</article>
									</li>
								))}
							</ol>
						)}
					</article>
				</li>
			))}
		</ol>
	)}
</section>

<style>
	.dv-comments {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.dv-comments-heading {
		font-size: var(--font-size-xl);
		font-weight: 600;
		color: var(--color-text);
		margin: 0;
	}

	.dv-comments-list,
	.dv-comment-replies {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.dv-comments-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.dv-comment {
		padding-bottom: var(--spacing-6);
		border-bottom: 1px solid var(--color-border-subtle, var(--color-border));
	}

	.dv-comments-list > li:last-child .dv-comment {
		border-bottom: none;
		padding-bottom: 0;
	}

	.dv-comment-header {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-2);
	}

	.dv-comment-avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 50%;
		color: #fff;
		font-size: var(--font-size-sm);
		font-weight: 600;
		flex-shrink: 0;
		user-select: none;
	}

	.dv-comment-avatar--sm {
		width: 2rem;
		height: 2rem;
		font-size: var(--font-size-xs);
	}

	.dv-comment-meta {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.dv-comment-author {
		font-weight: 600;
		font-size: var(--font-size-base);
		color: var(--color-text);
		line-height: 1.2;
	}

	.dv-comment-date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.dv-comment-body {
		color: var(--color-text);
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		white-space: pre-wrap;
		word-break: break-word;
		padding-left: calc(2.5rem + var(--spacing-3));
	}

	.dv-comment-body a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.dv-comment-replies {
		margin-top: var(--spacing-5);
		padding-left: calc(2.5rem + var(--spacing-3));
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
		border-left: 2px solid var(--color-border-subtle, var(--color-border));
		padding-left: var(--spacing-5);
		margin-left: var(--spacing-4);
	}

	.dv-comment-reply {
		padding-bottom: var(--spacing-5);
		border-bottom: 1px dashed var(--color-border-subtle, var(--color-border));
	}

	.dv-comment-replies > li:last-child .dv-comment-reply {
		border-bottom: none;
		padding-bottom: 0;
	}

	.dv-comment-reply .dv-comment-body {
		padding-left: calc(2rem + var(--spacing-3));
	}

	@media (max-width: 640px) {
		.dv-comment-body {
			padding-left: 0;
		}

		.dv-comment-reply .dv-comment-body {
			padding-left: 0;
		}

		.dv-comment-replies {
			padding-left: var(--spacing-3);
			margin-left: var(--spacing-2);
		}
	}
</style>
