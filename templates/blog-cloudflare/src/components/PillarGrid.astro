---
import { PILLARS, FEATURED_PILLARS } from "../data/pilares-visual";

interface Props {
	heading?: string;
	tagline?: string;
	/** Se true, mostra só os 6 featured (vitrine da home). Default false (todos os 12). */
	featuredOnly?: boolean;
	/** Mostra link "Ver todos os assuntos" embaixo. Default = igual a featuredOnly. */
	showAllLink?: boolean;
	/** Coluna count no desktop. Default 3 (combina com 6 ou 12 cards). */
	columns?: 3 | 4;
}

const {
	heading = "Escolha um assunto",
	tagline = "Conteúdos organizados por área de cuidado",
	featuredOnly = false,
	showAllLink,
	columns = 3,
} = Astro.props;

const pillarsToShow = featuredOnly ? FEATURED_PILLARS : PILLARS;
const shouldShowAllLink = showAllLink ?? featuredOnly;
---

<section
	class="pillar-grid-section"
	aria-labelledby={heading ? "pillar-grid-heading" : undefined}
	aria-label={heading ? undefined : "Categorias do blog"}
>
	{heading && (
		<header class="pillar-grid-header">
			<h2 id="pillar-grid-heading" class="pillar-grid-heading">{heading}</h2>
			{tagline && <p class="pillar-grid-tagline">{tagline}</p>}
		</header>
	)}

	<ul class={`pillar-grid columns-${columns}`}>
		{
			pillarsToShow.map((p) => (
				<li class="pillar-cell">
					<a
						href={`/blog/category/${p.slug}`}
						class="pillar-card"
						style={`--pillar-color: ${p.color};`}
					>
						<span class="pillar-emoji" aria-hidden="true">
							{p.emoji}
						</span>
						<span class="pillar-label">{p.label}</span>
					</a>
				</li>
			))
		}
	</ul>

	{
		shouldShowAllLink && (
			<div class="pillar-grid-footer">
				<a href="/blog/categorias" class="pillar-grid-all-link">
					Ver todos os assuntos →
				</a>
			</div>
		)
	}
</section>

<style>
	.pillar-grid-section {
		max-width: var(--wide-width);
		margin: var(--spacing-12) auto;
		padding: 0 var(--spacing-6);
	}

	.pillar-grid-header {
		text-align: center;
		margin-bottom: var(--spacing-6);
	}

	.pillar-grid-heading {
		font-size: var(--font-size-2xl);
		font-weight: 600;
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
	}

	.pillar-grid-tagline {
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
	}

	.pillar-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: var(--spacing-3);
	}

	.pillar-grid.columns-3 {
		grid-template-columns: repeat(3, 1fr);
	}

	.pillar-grid.columns-4 {
		grid-template-columns: repeat(4, 1fr);
	}

	.pillar-cell {
		display: block;
	}

	.pillar-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-3);
		aspect-ratio: 1 / 1;
		padding: var(--spacing-4);
		border-radius: var(--radius-lg);
		text-align: center;
		text-decoration: none;
		color: var(--color-text);
		/* Tinta da cor do pilar misturada com o bg da página: funciona em
		 * light/dark mode sem precisar duplicar regras. 18% é forte o suficiente
		 * pra identidade visual mas suave o bastante pra não competir com texto. */
		background: color-mix(in srgb, var(--pillar-color) 18%, var(--color-bg));
		border: 1px solid color-mix(in srgb, var(--pillar-color) 30%, transparent);
		transition:
			transform var(--transition-fast),
			border-color var(--transition-fast),
			background var(--transition-fast);
	}

	.pillar-card:hover,
	.pillar-card:focus-visible {
		transform: translateY(-2px);
		background: color-mix(in srgb, var(--pillar-color) 28%, var(--color-bg));
		border-color: color-mix(in srgb, var(--pillar-color) 50%, transparent);
		outline: none;
	}

	.pillar-emoji {
		font-size: 2.75rem;
		line-height: 1;
		display: block;
	}

	/* Label maior que a v1: público 55+ precisa de fonte legível,
	 * principalmente em card quadrado pequeno. */
	.pillar-label {
		font-size: var(--font-size-base);
		font-weight: 600;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-snug);
	}

	.pillar-grid-footer {
		text-align: center;
		margin-top: var(--spacing-6);
	}

	.pillar-grid-all-link {
		display: inline-block;
		padding: var(--spacing-2) var(--spacing-4);
		font-size: var(--font-size-base);
		font-weight: 500;
		color: var(--color-accent);
		text-decoration: none;
		border-radius: var(--radius);
		transition: color var(--transition-fast);
	}

	.pillar-grid-all-link:hover,
	.pillar-grid-all-link:focus-visible {
		color: var(--color-accent-hover);
		outline: none;
	}

	@media (max-width: 1024px) {
		.pillar-grid.columns-4 {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 640px) {
		.pillar-grid-section {
			margin: var(--spacing-8) auto;
		}

		.pillar-grid,
		.pillar-grid.columns-3,
		.pillar-grid.columns-4 {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-2);
		}

		.pillar-emoji {
			font-size: 2rem;
		}

		.pillar-label {
			font-size: var(--font-size-sm);
		}
	}
</style>
