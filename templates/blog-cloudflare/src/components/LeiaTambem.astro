---
/**
 * Box "Leia também" inline pra internal linking contextual no corpo do artigo.
 * Padrão visual baseado em tuasaude.com: border-left destacado, "Leia também:"
 * em pequeno, título do artigo em bold, URL slug embaixo em pequeno.
 *
 * Esse componente é registrado em pages/posts/[slug].astro como custom type
 * do <PortableText> (`components.type.leiaTambem`). O bloco PortableText
 * correspondente é emitido pelo pipeline editorial (md_to_portable.py) a
 * partir do marker `<!-- LEIA_TAMBEM: slug -->` que o writer Opus insere
 * contextualmente.
 *
 * Shape esperado do value:
 *   { _type: "leiaTambem", slug: "x-y-z", title: "Título...", href: "/posts/x-y-z" }
 */
interface Value {
	_type: "leiaTambem";
	slug: string;
	title: string;
	href: string;
}
interface Props {
	value: Value;
}
const { value } = Astro.props;
const { title, href } = value;
const displayUrl = `douravita.com.br${href}`;
---

<a href={href} class="leia-tambem-box">
	<span class="leia-tambem-label">Leia também:</span>
	<strong class="leia-tambem-title">{title}</strong>
	<span class="leia-tambem-url">{displayUrl}</span>
</a>

<style>
	.leia-tambem-box {
		display: block;
		border-left: 4px solid var(--color-accent);
		padding: var(--spacing-3) var(--spacing-4);
		margin: var(--spacing-6) 0;
		background: color-mix(in srgb, var(--color-accent) 6%, var(--color-bg));
		text-decoration: none;
		color: inherit;
		border-radius: 0 var(--radius) var(--radius) 0;
		transition: background var(--transition-fast);
	}

	.leia-tambem-box:hover,
	.leia-tambem-box:focus-visible {
		background: color-mix(in srgb, var(--color-accent) 12%, var(--color-bg));
		outline: none;
	}

	.leia-tambem-label {
		display: inline;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		margin-right: var(--spacing-1);
	}

	.leia-tambem-title {
		color: var(--color-text);
		font-weight: 600;
		font-size: var(--font-size-base);
		line-height: var(--leading-snug);
	}

	.leia-tambem-box:hover .leia-tambem-title {
		color: var(--color-accent);
	}

	.leia-tambem-url {
		display: block;
		color: var(--color-accent);
		font-size: var(--font-size-xs);
		margin-top: var(--spacing-1);
		word-break: break-all;
	}

	@media (max-width: 640px) {
		.leia-tambem-box {
			padding: var(--spacing-2) var(--spacing-3);
			margin: var(--spacing-4) 0;
		}
	}
</style>
