---
import { getMenu, getEmDashCollection, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { FEATURED_PILLARS } from "../data/pilares-visual";
import "../styles/theme.css";

// Categorias visiveis na barra horizontal do header (desktop).
// Labels CURTOS pra caber entre logo e busca sem enrolar.
const NAV_CATEGORIES: { slug: string; label: string; href?: string }[] = [
	{ slug: "suplementacao", label: "Suplementos" },
	{ slug: "movimento", label: "Movimento" },
	{ slug: "cuidador", label: "Cuidador" },
	{ slug: "saude-mental", label: "Mente" },
	{ slug: "doencas-cronicas", label: "Doenças" },
	{ slug: "vida-plena", label: "Bem-estar" },
	{ slug: "ferramentas", label: "Ferramentas", href: "/blog/ferramentas" },
	{ slug: "noticias", label: "Notícias" },
];

// Itens do menu mobile = featured pilares + Ferramentas (inserido antes de Noticias)
const MOBILE_MENU_ITEMS = (() => {
	const noticiasIdx = FEATURED_PILLARS.findIndex((p) => p.slug === "noticias");
	const toMenuItem = (p: typeof FEATURED_PILLARS[number]) => ({
		slug: p.slug,
		label: p.label,
		color: p.color,
		href: `/blog/category/${p.slug}`,
	});
	return [
		...FEATURED_PILLARS.slice(0, noticiasIdx).map(toMenuItem),
		{ slug: "ferramentas", label: "Testes e calculadoras", color: "#7B61FF", href: "/blog/ferramentas" },
		...FEATURED_PILLARS.slice(noticiasIdx).map(toMenuItem),
	];
})();

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Quando setado (ex: post pages), renderiza bloco Compartilhar no menu mobile */
	shareData?: { url: string; title: string } | null;
	/** Quando setado, sobrescreve o <title> final (bypass do auto-suffix
	 * com siteTitle). Use em post pages para evitar title de 130+ chars:
	 * passe `${post.title} | Blog DouraVita` aqui. Affecta tambem og:title
	 * (via pageCtx.title) e a tag <title> renderizada. */
	fullTitle?: string | null;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	shareData,
	fullTitle: fullTitleOverride,
} = Astro.props;

// Constroi share intents pro bloco mobile (so usado se shareData estiver setado).
const shareWaHref = shareData
	? `https://wa.me/?text=${encodeURIComponent(`${shareData.title} — DouraVita ${shareData.url}`)}`
	: null;
const shareFbHref = shareData
	? `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareData.url)}`
	: null;
const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(await getSiteSettings());
const LOGO_DARK_URL = "/_emdash/api/media/file/01KT1V2W48WMSTDC04TV90CNB1.png";
// siteTitle inclui o tagline ("Blog DouraVita - Vitalidade Ativa..."), o que
// estourava o limite SERP (~60 chars) quando appended em titles de paginas
// internas. Usamos a versao curta (antes do primeiro " - ") nesses appends.
// O siteTitle completo continua sendo o <title> da home (onde a frase
// completa carrega o ranking de "blog douravita").
const siteTitleShort = siteTitle.split(" - ")[0] || siteTitle;
// If title already includes site title (from getSeoMeta), use as-is
const _computedFullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitleShort}`;
const fullTitle = fullTitleOverride ?? _computedFullTitle;

// Fetch primary menu defined in seed
const menu = await getMenu("primary");

// Fetch pages for footer
const { entries: pages } = await getEmDashCollection("pages");

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Detecta slug da categoria atual a partir do path /blog/category/<slug>
// pra destacar o item correspondente no menu fixo do header (desktop).
const _categoryMatch = Astro.url.pathname.match(/(?:^|\/blog)\/category\/([^/]+)/);
const normPath = (s) => s.replace(/^\/blog/, "").replace(/\/+$/, "") || "/";
const activeCategorySlug = _categoryMatch ? _categoryMatch[1] : null;

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<!-- Google Analytics 4 -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9BF05HSEEL"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag("js", new Date());
			gtag("config", "G-9BF05HSEEL");
		</script>
		<script is:inline>
			// Apply theme immediately to prevent flash
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				} else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					document.documentElement.classList.add("dark");
				}
			})();
		</script>
		<script is:inline>
			// A11y 55+ Fase 3: aplica font-size do cookie ANTES do paint
			// (sem FOUC). Cookie `font-size=sm|md|lg|xl`; default md.
			// Componente FontSizeWidget.astro cuida da UI + escrita.
			(function () {
				var m = document.cookie.match(/(?:^|;\s*)font-size=([^;]+)/);
				var v = m ? decodeURIComponent(m[1]) : "md";
				if (v !== "sm" && v !== "md" && v !== "lg" && v !== "xl") v = "md";
				document.documentElement.setAttribute("data-font-size", v);
			})();
		</script>
		<script is:inline>
			// Limpa hash orfa: se a URL tem #algo mas a pagina nao tem elemento
			// com esse id, remove a hash sem rolar. Anchors validas (ex: #faq em
			// posts) continuam funcionando porque querySelector acha o elemento.
			(function () {
				function cleanOrphanHash() {
					var hash = window.location.hash;
					if (!hash || hash.length < 2) return;
					try {
						if (!document.querySelector(hash)) {
							var clean = window.location.pathname + window.location.search;
							history.replaceState(null, "", clean);
						}
					} catch (e) { /* selector invalido, ignora */ }
				}
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", cleanOrphanHash);
				} else {
					cleanOrphanHash();
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<button
					type="button"
					class="mobile-menu-toggle"
					aria-label="Abrir menu de categorias"
					aria-controls="mobile-menu-overlay"
					aria-expanded="false"
				>
					<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<line x1="3" y1="6" x2="21" y2="6"></line>
						<line x1="3" y1="12" x2="21" y2="12"></line>
						<line x1="3" y1="18" x2="21" y2="18"></line>
					</svg>
					<span class="mobile-menu-label">Menu</span>
				</button>
				<a href="/blog" class="site-title">
					{siteLogo ? (
						<>
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img site-logo-img--light" />
							<img src={LOGO_DARK_URL} alt={siteLogo.alt || siteTitle} class="site-logo-img site-logo-img--dark" />
						</>
					) : siteTitle}
				</a>
				<ul class="nav-categories" aria-label="Categorias">
					{NAV_CATEGORIES.map((c) => (
						<li>
							<a
								href={c.href ?? `/blog/category/${c.slug}`}
								class="nav-category-item"
								aria-current={c.slug === activeCategorySlug ? "page" : undefined}
							>
								{c.label}
							</a>
						</li>
					))}
				</ul>
				<div class="nav-right">
					<LiveSearch
						placeholder="Buscar..."
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
						pathPrefix="/blog"
						searchPagePath="/blog/search"
					/>
					<div class="nav-links">
						{
							menu?.items.map((item) => (
								<a href={item.url} target={item.target}>
									{item.label}
								</a>
							))
						}
					</div>
					<div class="theme-switcher nav-theme-switcher">
						<button
							type="button"
							class="theme-btn"
							data-theme="light"
							aria-label="Modo claro"
						>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
						</button>
						<button
							type="button"
							class="theme-btn"
							data-theme="dark"
							aria-label="Modo escuro"
						>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
						</button>
					</div>
				</div>
				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="nav-admin">
							Admin
						</a>
					)
				}
			</nav>
		</header>

		<aside
			class="mobile-menu-overlay"
			id="mobile-menu-overlay"
			aria-hidden="true"
		>
			<div class="mobile-menu-drawer" role="dialog" aria-label="Menu de categorias">
				<div class="mobile-menu-header">
					<span class="mobile-menu-title">Assuntos</span>
					<button type="button" class="mobile-menu-close" aria-label="Fechar menu">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
				<ul class="mobile-menu-list">
					{MOBILE_MENU_ITEMS.map((p) => (
						<li>
							<a
								href={p.href}
								class="mobile-menu-item"
								style={`--pillar-color: ${p.color};`}
								aria-current={normPath(Astro.url.pathname) === normPath(p.href) ? "page" : undefined}
							>
								<span class="mobile-menu-label">{p.label}</span>
								<svg class="mobile-menu-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="9 18 15 12 9 6"></polyline>
								</svg>
							</a>
						</li>
					))}
				</ul>
				{shareData && (
					<div class="mobile-menu-share">
						<span class="mobile-menu-share-title">Compartilhar este artigo</span>
						<div class="mobile-menu-share-list">
							<a
								href={shareWaHref}
								target="_blank"
								rel="noopener noreferrer"
								class="mobile-share-btn mobile-share-btn--whatsapp"
								aria-label="Compartilhar no WhatsApp"
							>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path></svg>
								<span>WhatsApp</span>
							</a>
							<a
								href={shareFbHref}
								target="_blank"
								rel="noopener noreferrer"
								class="mobile-share-btn mobile-share-btn--facebook"
								aria-label="Compartilhar no Facebook"
							>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
								<span>Facebook</span>
							</a>
							<button
								type="button"
								class="mobile-share-btn mobile-share-btn--copy"
								data-share-copy
								data-share-url={shareData.url}
								aria-label="Copiar link do artigo"
							>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
								<span data-share-copy-label>Copiar link</span>
							</button>
						</div>
					</div>
				)}
				<a href="/blog/categorias" class="mobile-menu-all">Ver todos os assuntos →</a>

			</div>
		</aside>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-institutional">
					<a href="/blog" class="footer-logo footer-logo--institutional">
						{siteLogo ? (
							<>
								<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="footer-logo-img footer-logo-img--light" />
								<img src={LOGO_DARK_URL} alt={siteLogo.alt || siteTitle} class="footer-logo-img footer-logo-img--dark" />
							</>
						) : siteTitle}
					</a>
					<p class="footer-about">
						A DouraVita é um espaço informativo e educativo dedicado a quem
						tem 55 anos ou mais. Reunimos conteúdo baseado em ciência sobre
						suplementação, movimento, nutrição, saúde mental e cuidado com a
						família, sempre em linguagem acessível. As informações
						publicadas têm caráter educacional e não substituem o diagnóstico
						ou tratamento de um profissional de saúde qualificado, nem
						dispensam consulta médica.
					</p>
					<p class="footer-address">
						<strong>Endereço:</strong> Av. Carmela Dutra, 180, Galpão 20,
						Jardim Presidente Dutra, Guarulhos/SP, CEP 07170-150
					</p>
				</div>
				<div class="footer-grid">
					<div class="footer-brand">
						<p class="footer-tagline">{siteTagline}</p>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">Navegação</h2>
						<ul class="footer-links">
							<li><a href="/blog">Início</a></li>
							<li><a href="/blog/posts">Todos os artigos</a></li>
							<li><a href="/blog/categorias">Categorias</a></li>
						</ul>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">Institucional</h2>
						<ul class="footer-links">
							{
								pages.slice(0, 3).map((page) => (
									<li>
										<a href={`/blog/pages/${page.data.slug || page.id}`}>
											{page.data.title}
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<div class="footer-widgets-section">
						<h2 class="footer-heading">Redes Sociais</h2>
						<div class="social-buttons">
							<button type="button" class="social-btn social-btn--instagram" aria-label="Instagram da DouraVita" onclick="window.open('https://instagram.com/vivadouravita', '_blank', 'noopener,noreferrer')">
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
							</button>
							<button type="button" class="social-btn social-btn--facebook" aria-label="Facebook da DouraVita" onclick="window.open('https://facebook.com/Douravita', '_blank', 'noopener,noreferrer')">
