---
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return new Response(
		`<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><title>Tag nao encontrada</title><meta name="robots" content="noindex"></head><body style="font-family:system-ui,sans-serif;max-width:42rem;margin:4rem auto;padding:0 1rem;color:#333"><h1>Tag nao encontrada</h1><p>Essa tag nao existe no blog. <a href="/blog">Voltar para o inicio</a>.</p></body></html>`,
		{
			status: 404,
			statusText: "Not Found",
			headers: { "content-type": "text/html; charset=utf-8" },
		},
	);
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Edge cache: ver comentario em posts/[slug].astro.
Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

// Single batched query for tags on every post tagged with this term,
// rather than calling getEntryTerms() per post.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base
	title={`Artigos com a tag "${term.label}"`}
	description={`Todos os artigos com a tag ${term.label}`}
	canonical={`${Astro.url.origin}/blog/tag/${term.slug}`}
>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Tag</span>
			<h1 class="archive-title">{term.label}</h1>
			<p class="archive-count">
				{filteredPosts.length}
				{filteredPosts.length === 1 ? "artigo" : "artigos"}
			</p>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">Nenhum artigo com esta tag ainda.</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/blog/posts/${post.slug ?? post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.archive-header {
		margin-bottom: var(--spacing-10);
		padding: var(--spacing-8);
		border: 1px solid var(--color-border-subtle);
		border-radius: calc(var(--radius-lg) * 2);
		background: color-mix(in oklch, var(--color-accent) 5%, var(--color-bg));
	}

	.archive-label {
		display: inline-flex;
		align-items: center;
		min-height: 34px;
		padding: 0 var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: var(--color-accent-hover);
		background: color-mix(in oklch, var(--color-accent) 12%, var(--color-bg));
		border: 1px solid color-mix(in oklch, var(--color-accent) 18%, var(--color-border));
		border-radius: 999px;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-4);
	}

	.archive-title {
		font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-5xl));
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: -0.035em;
		margin-bottom: var(--spacing-3);
	}

	.archive-count {
		font-size: var(--font-size-lg);
		color: var(--color-text-secondary);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8) var(--spacing-6);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
