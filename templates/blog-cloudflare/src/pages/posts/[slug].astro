---
import {
	getEmDashEntry,
	getEmDashCollection,
	getEntryTerms,
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import {
	Image,
	PortableText,
	Comments,
	CommentForm,
	WidgetArea,
} from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import LeiaTambem from "../../components/LeiaTambem.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

// Custom PortableText component pra blocos `_type: 'leiaTambem'` emitidos
// pelo pipeline (md_to_portable.py). Registra via prop `components.type`
// no <PortableText> abaixo — astro-portabletext merge com defaults EmDash.
const portableTextComponents = {
	type: {
		leiaTambem: LeiaTambem,
	},
};

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Edge cache pra Cloudflare. s-maxage=60 = CDN segura por 60s (mudanças via
// publish aparecem em ~1min); stale-while-revalidate=86400 = serve stale por
// 24h em background enquanto revalida (usuário sempre vê página rápida).
// Render server-side custa ~2s (15 queries no D1); cache HIT cai pra ~30ms.
Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${Astro.url.origin}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
const settings = await getSiteSettings();
const { siteTitle } = resolveBlogSiteIdentity(settings);

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/blog/posts/${slug}`,
	defaultOgImage: featuredImageUrl,
	titleSeparator: settings.seo?.titleSeparator,
});

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

// Fetch this post's tags and the related-posts list in parallel — they're
// independent queries, so running them concurrently halves the round-trip
// cost on remote databases.
// Note: post.id is the slug, post.data.id is the database ULID.
const [tags, categories, { entries: recentPosts }] = await Promise.all([
	getEntryTerms("posts", post.data.id, "tag"),
	getEntryTerms("posts", post.data.id, "category"),
	// Fetch a few extra in case the current post is among them
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	}),
]);
const category = categories[0];
const otherPosts = recentPosts.filter((p) => p.id !== post.id).slice(0, 3);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherCategoriesByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"category",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: otherTagsByEntry.get(p.data.id) ?? [],
	category: (otherCategoriesByEntry.get(p.data.id) ?? [])[0],
	bylines: p.data.bylines ?? [],
}));

const publishDate =
	post.data.publishedAt?.toLocaleDateString("pt-BR", {
		year: "numeric",
		month: "long",
		day: "numeric",
	}) ?? null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article">
		{/* Hero: Full-width featured image */}
		{
			post.data.featured_image && (
				<div class="article-hero" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</div>
			)
		}

		{/* Three-column layout */}
		<div class="article-grid">
			{/* Left gutter: Meta information */}
			<aside class="article-meta-col">
				<div class="meta-sticky">
					{
						bylines.length > 0 && (
							<div class="meta-block byline-block">
								<span class="meta-label">
									{bylines.length === 1 ? "Autor" : "Autores"}
								</span>
								<div class="bylines">
									{bylines.map((credit) => (
										<div class="byline">
											{credit.byline.avatarMediaId && (
												<img
													src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
													alt={credit.byline.displayName}
													class="byline-avatar"
												/>
											)}
											<div class="byline-info">
												<span class="byline-name">
													{credit.byline.displayName}
												</span>
												{credit.roleLabel && (
													<span class="byline-role">{credit.roleLabel}</span>
												)}
											</div>
										</div>
									))}
								</div>
							</div>
						)
					}
					{
						publishDate && (
							<div class="meta-block">
								<span class="meta-label">Publicado em</span>
								<time class="meta-value">{publishDate}</time>
							</div>
						)
					}
					<div class="meta-block">
						<span class="meta-label">Tempo de leitura</span>
						<span class="meta-value">{readingTime} min</span>
					</div>
					{
						category && (
							<div class="meta-block">
								<span class="meta-label">Categoria</span>
								<a href={`/blog/category/${category.slug}`} class="meta-category">
									{category.label}
								</a>
							</div>
						)
					}
					{/* Ícones de redes sociais — só desktop (mobile usa footer). */}
					<div class="meta-block meta-social-block">
						<span class="meta-label">Compartilhar</span>
						<div class="meta-socials">
							<a
								href="https://instagram.com/vivadouravita"
								target="_blank"
								rel="noopener noreferrer"
								class="meta-social meta-social--instagram"
								aria-label="Instagram da DouraVita"
							>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
							</a>
							<a
								href="https://facebook.com/Douravita"
								target="_blank"
								rel="noopener noreferrer"
								class="meta-social meta-social--facebook"
								aria-label="Facebook da DouraVita"
							>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
							</a>
							<a
								href="https://wa.me/551130038678"
								target="_blank"
								rel="noopener noreferrer"
								class="meta-social meta-social--whatsapp"
								aria-label="WhatsApp da DouraVita"
							>
								<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path></svg>
							</a>
						</div>
					</div>
					{
						tags.length > 0 && (
							<div class="meta-block">
								<span class="meta-label">Tags</span>
								<div class="meta-tags">
									{tags.map((t) => (
										<a href={`/blog/tag/${t.slug}`} class="meta-tag">
											{t.label}
										</a>
									))}
								</div>
							</div>
						)
					}
				</div>
			</aside>

			{/* Main content */}
			<div class="article-main">
				<header class="article-header">
					<div class="article-meta">
						{
							bylines.length > 0 && (
								<>
									<span class="article-meta-byline">
										{bylines.map((credit, i) => (
											<>
												{i > 0 && ", "}
												{credit.byline.displayName}
											</>
										))}
									</span>
									<span class="meta-dot" />
								</>
							)
						}
						{
							publishDate && (
								<>
									<time>{publishDate}</time>
									<span class="meta-dot" />
								</>
							)
						}
						<span>{readingTime} min de leitura</span>
					</div>
					{category && (
						<a
							href={`/blog/category/${category.slug}`}
							class="article-category"
						>
							{category.label}
						</a>
					)}
					<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
					{
						post.data.excerpt && (
							<p class="article-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
						)
					}
				</header>

				<div class="article-content">
					<PortableText value={post.data.content} components={portableTextComponents} />
				</div>

				<div class="article-comments">
					<Comments collection="posts" contentId={post.data.id} threaded />
					<CommentForm collection="posts" contentId={post.data.id} />
				</div>
			</div>

			{/* Right gutter: TOC + Sidebar widgets */}
			<aside class="article-sidebar">
				<div class="sidebar-sticky">
					<nav class="toc" aria-label="Sumário">
						<h2 class="toc-title">Nesta página</h2>
						<div class="toc-content" id="toc-content">
							<!-- Populated by JS -->
						</div>
					</nav>
					<div class="sidebar-widgets">
						<WidgetArea name="sidebar" />
					</div>
				</div>
			</aside>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="more-posts">
				<div class="more-inner">
					<h2 class="more-title">Continue lendo</h2>
					<div class="more-grid">
						{otherPostsWithTags.map(
							({ post: p, tags: postTags, category: postCategory, bylines: postBylines }) => (
								<PostCard
									title={p.data.title}
									excerpt={p.data.excerpt}
									featuredImage={p.data.featured_image}
									href={`/blog/posts/${p.slug ?? p.id}`}
									date={p.data.publishedAt ?? undefined}
									readingTime={getReadingTime(p.data.content)}
									tags={postTags.map((t) => ({ slug: t.slug, label: t.label }))}
									category={postCategory ? { slug: postCategory.slug, label: postCategory.label } : undefined}
									bylines={postBylines}
									headingLevel={3}
								/>
							)
						)}
					</div>
				</div>
			</section>
		)
	}

	<script>
		// O Sumário inline do post tem links tipo `[texto](#o-que-e)`, mas os H2
		// do conteúdo não têm `id` (o pipeline sanitiza `{#anchor}` antes do publish
		// e o PortableText do EmDash não suporta IDs em heading blocks).
		// Estratégia: pega os anchors do Sumário em ordem e atribui posicionalmente
		// aos H2 que vêm DEPOIS do Sumário. A ordem é confiável (o template gera
		// Sumário na mesma sequência dos H2 do conteúdo), e isso é robusto a casos
		// onde o LLM customiza o texto do H2 mas deixa o link do Sumário no genérico.
		function hoistInlineAnchors() {
			const content = document.querySelector(".article-content");
			if (!content) return;

			// Pass A: trata `{#anchor}` legacy ainda no DOM (posts não-resanitizados).
			const legacyRe = /\s*\{#([a-zA-Z0-9_-]+)\}\s*$/;
			content.querySelectorAll("h2, h3, h4").forEach((heading) => {
				const m = (heading.textContent || "").match(legacyRe);
				if (!m) return;
				const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
				let last = null;
				while (walker.nextNode()) last = walker.currentNode;
				if (last && last.nodeValue) {
					last.nodeValue = last.nodeValue.replace(legacyRe, "");
				}
				if (!heading.id) heading.id = m[1];
			});

			// Pass B: matching posicional via Sumário.
			const anchorLinks = Array.from(
				content.querySelectorAll('a[href^="#"]')
			).filter((a) => {
				const href = a.getAttribute("href") || "";
				// ignora links âncora pra outros recursos (e.g. #faq vindo de outro lugar)
				return /^#[a-zA-Z][\w-]*$/.test(href);
			});
			if (anchorLinks.length === 0) return;
			const lastLink = anchorLinks[anchorLinks.length - 1];
			const anchorIds = anchorLinks.map((a) =>
				(a.getAttribute("href") || "").slice(1)
			);

			// H2s que vêm DEPOIS do último link âncora (= H2s do conteúdo, não os
			// "Resposta direta"/"Principais pontos"/"Sumário" que vêm antes).
			const contentH2 = Array.from(content.querySelectorAll("h2")).filter(
				(h2) =>
					lastLink.compareDocumentPosition(h2) &
					Node.DOCUMENT_POSITION_FOLLOWING
			);

			const n = Math.min(anchorIds.length, contentH2.length);
			for (let i = 0; i < n; i++) {
				if (!contentH2[i].id) contentH2[i].id = anchorIds[i];
			}
		}

		// Build table of contents from h2/h3 headings
		function buildToc() {
			const content = document.querySelector(".article-content");
			const tocContainer = document.getElementById("toc-content");
			if (!content || !tocContainer) return;

			const headings = content.querySelectorAll("h2, h3");
			if (headings.length === 0) {
				// Hide TOC if no headings
				const toc = document.querySelector(".toc") as HTMLElement | null;
				if (toc) toc.style.display = "none";
				return;
			}

			const list = document.createElement("ul");
			list.className = "toc-list";

			headings.forEach((heading, index) => {
				// Add ID if missing
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const li = document.createElement("li");
				li.className =
					heading.tagName === "H3" ? "toc-item toc-item--nested" : "toc-item";

				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc-link";
				link.textContent = heading.textContent;

				li.appendChild(link);
				list.appendChild(li);
			});

			tocContainer.appendChild(list);

			// Highlight current section on scroll
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						const id = entry.target.id;
						const link = tocContainer.querySelector(`a[href="#${id}"]`);
						if (link) {
							if (entry.isIntersecting) {
								tocContainer
									.querySelectorAll(".toc-link")
									.forEach((l) => l.classList.remove("active"));
								link.classList.add("active");
							}
						}
					});
				},
				{ rootMargin: "-80px 0px -80% 0px" }
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		hoistInlineAnchors();
		buildToc();
	</script>
</Base>

<style>
	/* Article container */
	.article {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	/* Hero image - full width within container */
	.article-hero {
		margin: var(--spacing-16) var(--spacing-6);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-surface);
	}

	.article-hero img {
		width: 100%;
		height: auto;
		max-height: 500px;
		object-fit: cover;
	}

	/* Three-column grid */
	.article-grid {
		display: grid;
		grid-template-columns:
			var(--meta-col-width) minmax(0, var(--content-width))
			var(--gutter-width);
		gap: var(--spacing-10);
		justify-content: center;
		padding: 0 var(--spacing-6);
		margin: var(--spacing-16) 0;
	}

	/* Left column: Meta */
	.article-meta-col {
		display: block;
	}

	.meta-sticky {
		position: sticky;
		top: calc(var(--nav-height) + var(--spacing-8));
	}

	.meta-block {
		margin-bottom: var(--spacing-6);
	}

	.meta-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
		margin-bottom: var(--spacing-1);
	}

	.meta-value {
		display: block;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.meta-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1);
	}

	.meta-category {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-accent);
		background: var(--color-accent-ring, var(--color-surface));
		border-radius: var(--radius);
		text-decoration: none;
	}

	.meta-category:hover {
		background: var(--color-border);
	}

	.meta-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-radius: var(--radius);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.meta-tag:hover {
		color: var(--color-text);
		background: var(--color-border);
	}

	/* Social icons na sidebar do artigo (desktop only; sidebar inteira ja é
	 * display:none em <= 1100px). Mantem identidade visual dos botoes do
	 * footer mas em tamanho compacto. */
	.meta-social-block {
		display: flex;
		flex-direction: column;
	}

	.meta-socials {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
