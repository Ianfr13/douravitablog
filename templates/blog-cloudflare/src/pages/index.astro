import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
	search,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import creatinaPoteImg from "../assets/creatina-pote.webp";
import creatinaLaudoImg from "../assets/creatina-laudo.webp";

// Fetch generoso: 30 posts em DESC. Vamos splittar em "momento" (5 mais
// recentes), "mais lidos" (8 mais antigos) e "recentes" (6 do meio sem
// repetir). Em produção (~21 posts) cabe tudo sem N+1.
const POSTS_TO_FETCH = 30;

const [{ entries: allPosts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_TO_FETCH,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

// Section 1 — Assuntos do momento: 2 large + 3 small (5 mais recentes)
const trending = allPosts.slice(0, 5);
const trendingLarge = trending.slice(0, 2);
const trendingSmall = trending.slice(2, 5);
const usedIds = new Set(trending.map((p) => p.data.id));

// Section 3 — Mais lidos: 8 mais antigos (proxy de "tempo exposto")
const mostRead: typeof allPosts = [];
for (let i = allPosts.length - 1; i >= 0 && mostRead.length < 8; i--) {
	const post = allPosts[i];
	if (usedIds.has(post.data.id)) continue;
	mostRead.push(post);
	usedIds.add(post.data.id);
}

// Section 5 — Conteúdos recentes (só títulos): 6 do meio sem repetir
const recentTitles: typeof allPosts = [];
for (const post of allPosts) {
	if (recentTitles.length >= 6) break;
	if (usedIds.has(post.data.id)) continue;
	recentTitles.push(post);
	usedIds.add(post.data.id);
}

// Batch query: categorias dos posts que aparecem como card (não dos só-título)
const cardIds = [
	...trending.map((p) => p.data.id),
	...mostRead.map((p) => p.data.id),
];
const categoriesByEntry = await getTermsForEntries(
	"posts",
	cardIds,
	"category",
);

type CategoryRef = { slug: string; label: string };

function withCategory(post: typeof allPosts[0]) {
	return {
		post,
		category: ((categoriesByEntry.get(post.data.id) ?? [])[0]) as
			| CategoryRef
			| undefined,
	};
}

const trendingLargeWithCat = trendingLarge.map(withCategory);
const trendingSmallWithCat = trendingSmall.map(withCategory);
const mostReadWithCat = mostRead.map(withCategory);

// Section 4 — Recomendações de palavras-chave por categoria.
// Candidatos vêm de src/pilares.py (subtópicos das 12 pillars). Cada
// candidato é validado em build-time via search() do EmDash (FTS):
// só sobrevive se existir AO MENOS 1 artigo que dá match. Quando um
// novo artigo é publicado contendo a keyword, ela aparece sozinha na
// próxima revalidação do edge cache (60s).
//
// Limite: 8 keywords por categoria (top-8 dos que sobreviveram).
const KEYWORDS_PER_CATEGORY_MAX = 8;

const keywordCandidatesByCategory: {
	slug: string;
	label: string;
	candidates: string[];
}[] = [
	{
		slug: "suplementacao",
		label: "Suplementação",
		candidates: [
			"creatina",
			"whey protein",
			"vitamina D",
			"vitamina B12",
			"ômega 3",
			"colágeno",
			"magnésio",
			"glutamina",
			"melatonina",
			"multivitamínico",
			"probiótico",
		],
	},
	{
		slug: "movimento",
		label: "Movimento",
		candidates: [
			"musculação",
			"caminhada",
			"yoga",
			"pilates",
			"alongamento",
			"equilíbrio",
			"prevenção de quedas",
			"exercícios em casa",
			"hidroginástica",
			"fisioterapia",
			"força muscular",
		],
	},
	{
		slug: "saude-mental",
		label: "Saúde Mental",
		candidates: [
			"memória",
			"sono",
			"ansiedade",
			"depressão",
			"demência",
			"Alzheimer",
			"neuroplasticidade",
			"isolamento social",
			"luto",
			"bem-estar emocional",
		],
	},
	{
		slug: "doencas-cronicas",
		label: "Doenças Crônicas",
		candidates: [
			"diabetes",
			"hipertensão",
			"osteoporose",
			"artrose",
			"artrite",
			"colesterol",
			"AVC",
			"refluxo",
			"DPOC",
			"fibromialgia",
			"gota",
		],
	},
	{
		slug: "vida-plena",
		label: "Vida Plena",
		candidates: [
			"solidão",
			"viagem",
			"finanças",
			"netos",
			"voluntariado",
			"sexo na maturidade",
			"relacionamento",
			"novo amor",
			"voltar a estudar",
			"propósito",
		],
	},
	{
		slug: "cuidador",
		label: "Cuidador",
		candidates: [
			"cuidar do pai",
			"cuidar da mãe",
			"polifarmácia",
			"casa segura",
			"sinais de alerta",
			"plano de cuidado",
			"ILPI",
			"lei do idoso",
			"asilo",
		],
	},
	{
		slug: "noticias",
		label: "Notícias",
		candidates: [
			"alerta Anvisa",
			"novo estudo",
			"recall",
			"novo medicamento",
			"Outubro Rosa",
			"Novembro Azul",
			"mudança SUS",
		],
	},
];

// Build-time: pra cada candidato, FTS check. Mantém só os que têm artigo.
// Promise.all paraleliza — 12 cats × ~10 kws = ~120 queries em paralelo no D1.
// Edge cache de 60s amortiza isso (1x por minuto no caso pior).
const keywordsByCategory = (
	await Promise.all(
		keywordCandidatesByCategory.map(async (cat) => {
			const checked = await Promise.all(
				cat.candidates.map(async (kw) => {
					try {
						const { items } = await search(kw, {
							collections: ["posts"],
							limit: 1,
						});
						return items.length > 0 ? kw : null;
					} catch {
						return null;
					}
				}),
			);
			const valid = checked.filter((k): k is string => k !== null);
			return {
				slug: cat.slug,
				label: cat.label,
				keywords: valid.slice(0, KEYWORDS_PER_CATEGORY_MAX),
			};
		}),
	)
).filter((c) => c.keywords.length > 0);

// Quiz de sarcopenia: 6 perguntas sim/não. JS calcula score no client.
// Critérios baseados em SARC-F (validado) + fatores de risco comuns 55+.
const sarcQuestions = [
	"Tenho 65 anos ou mais",
	"Sinto fraqueza ou dor nas pernas ao subir escadas",
	"Perdi mais de 3 kg sem querer nos últimos 6 meses",
	"Fico mais de 6 horas por dia sentado(a) ou parado(a)",
	"NÃO faço exercícios de força (musculação) pelo menos 2 vezes por semana",
	"Tenho dificuldade em abrir potes ou garrafas que abria fácil antes",
];

const slugFor = (post: typeof allPosts[0]) => post.slug ?? post.id;
