---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import creatinaPoteImg from "../assets/creatina-pote.webp";
import creatinaLaudoImg from "../assets/creatina-laudo.webp";

// Fetch generoso: 30 posts em DESC. Vamos splittar em "momento" (5 mais
// recentes), "mais lidos" (8 mais antigos) e "recentes" (6 do meio sem
// repetir). Em produção (~21 posts) cabe tudo sem N+1.
const POSTS_TO_FETCH = 30;

const [{ entries: allPosts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_TO_FETCH,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

// Section 1 — Assuntos do momento: 2 large + 3 small (5 mais recentes)
const trending = allPosts.slice(0, 5);
const trendingLarge = trending.slice(0, 2);
const trendingSmall = trending.slice(2, 5);
const usedIds = new Set(trending.map((p) => p.data.id));

// Section 3 — Mais lidos: 8 mais antigos (proxy de "tempo exposto")
const mostRead: typeof allPosts = [];
for (let i = allPosts.length - 1; i >= 0 && mostRead.length < 8; i--) {
	const post = allPosts[i];
	if (usedIds.has(post.data.id)) continue;
	mostRead.push(post);
	usedIds.add(post.data.id);
}

// Section 5 — Conteúdos recentes (só títulos): 6 do meio sem repetir
const recentTitles: typeof allPosts = [];
for (const post of allPosts) {
	if (recentTitles.length >= 6) break;
	if (usedIds.has(post.data.id)) continue;
	recentTitles.push(post);
	usedIds.add(post.data.id);
}

// Batch query: categorias dos posts que aparecem como card (não dos só-título)
const cardIds = [
	...trending.map((p) => p.data.id),
	...mostRead.map((p) => p.data.id),
];
const categoriesByEntry = await getTermsForEntries(
	"posts",
	cardIds,
	"category",
);

type CategoryRef = { slug: string; label: string };

function withCategory(post: typeof allPosts[0]) {
	return {
		post,
		category: ((categoriesByEntry.get(post.data.id) ?? [])[0]) as
			| CategoryRef
			| undefined,
	};
}

const trendingLargeWithCat = trendingLarge.map(withCategory);
const trendingSmallWithCat = trendingSmall.map(withCategory);
const mostReadWithCat = mostRead.map(withCategory);

// Quiz de sarcopenia: 6 perguntas sim/não. JS calcula score no client.
// Critérios baseados em SARC-F (validado) + fatores de risco comuns 55+.
const sarcQuestions = [
	"Tenho 65 anos ou mais",
	"Sinto fraqueza ou dor nas pernas ao subir escadas",
	"Perdi mais de 3 kg sem querer nos últimos 6 meses",
	"Fico mais de 6 horas por dia sentado(a) ou parado(a)",
	"NÃO faço exercícios de força (musculação) pelo menos 2 vezes por semana",
	"Tenho dificuldade em abrir potes ou garrafas que abria fácil antes",
];

const slugFor = (post: typeof allPosts[0]) => post.slug ?? post.id;
---

<Base
	title={siteTitle}
	description={siteTagline}
	canonical={`${Astro.url.origin}/blog`}
>
	<h1 class="home-page-heading">{siteTitle}</h1>

	{
		allPosts.length === 0 ? (
			<section class="empty-state">
				<h2>Nenhum artigo ainda</h2>
				<p>Crie seu primeiro artigo no painel administrativo.</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">
					Criar um artigo
				</a>
			</section>
		) : (
			<div class="home-content">
				{/* ====== 0. INTRO — quem somos (SEO + boas-vindas) ====== */}
				<section class="home-intro" aria-label="Sobre o Blog DouraVita">
					<p class="home-intro-text">
						Bem-vindo ao <strong>Blog DouraVita</strong> — conteúdo de saúde
						e bem-estar baseado em ciência para adultos 55+. Aqui no nosso
						blog você encontra artigos sobre suplementação, movimento,
						memória, longevidade e qualidade de vida.
					</p>
				</section>

				{/* ====== 1. ASSUNTOS DO MOMENTO ====== */}
				<section class="section trending">
					<header class="section-header">
						<h2 class="section-title">Assuntos do momento</h2>
					</header>

					<div class="trending-large-grid">
						{trendingLargeWithCat.map(({ post, category }) => (
							<article class="card-large">
								{post.data.featured_image && (
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-large-image-link"
										aria-label={post.data.title}
									>
										<div class="card-large-image">
											<Image image={post.data.featured_image} />
										</div>
									</a>
								)}
								<div class="card-large-body">
									{category && (
										<a
											href={`/blog/category/${category.slug}`}
											class="badge"
										>
											{category.label}
										</a>
									)}
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-title-link"
									>
										<h3 class="card-large-title">
											{post.data.title ?? "Sem título"}
										</h3>
									</a>
									{(post.data.excerpt ?? post.data.description) && (
										<p class="card-large-excerpt">
											{post.data.excerpt ?? post.data.description}
										</p>
									)}
								</div>
							</article>
						))}
					</div>

					<div class="trending-small-list">
						{trendingSmallWithCat.map(({ post, category }) => (
							<article class="card-small">
								{post.data.featured_image && (
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-small-image-link"
										aria-label={post.data.title}
									>
										<Image image={post.data.featured_image} />
									</a>
								)}
								<div class="card-small-body">
									{category && (
										<a
											href={`/blog/category/${category.slug}`}
											class="badge"
										>
											{category.label}
										</a>
									)}
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-title-link"
									>
										<h3 class="card-small-title">
											{post.data.title ?? "Sem título"}
										</h3>
									</a>
									{(post.data.excerpt ?? post.data.description) && (
										<p class="card-small-excerpt">
											{post.data.excerpt ?? post.data.description}
										</p>
									)}
								</div>
							</article>
						))}
					</div>
				</section>

				{/* ====== 2. QUIZ INTERATIVO: SARCOPENIA ====== */}
				<section id="quiz-sarcopenia" class="section quiz-section">
					<div class="quiz-card" data-quiz>
						<header class="quiz-header">
							<span class="quiz-eyebrow">Conteúdo interativo</span>
							<h2 class="quiz-title">Você está em risco de sarcopenia?</h2>
							<p class="quiz-subtitle">
								Sarcopenia é a perda de massa e força muscular ligada ao
								envelhecimento. Responda 6 perguntas rápidas e descubra seu
								nível de risco.
							</p>
						</header>

						<form class="quiz-form" data-quiz-form>
							{sarcQuestions.map((q, i) => (
								<fieldset class="quiz-question">
									<legend class="quiz-q-text">
										<span class="quiz-q-num">{i + 1}.</span> {q}
									</legend>
									<div class="quiz-q-options">
										<label class="quiz-option">
											<input type="radio" name={`q${i}`} value="1" />
											<span>Sim</span>
										</label>
										<label class="quiz-option">
											<input type="radio" name={`q${i}`} value="0" />
											<span>Não</span>
										</label>
									</div>
								</fieldset>
							))}

							<button type="submit" class="quiz-submit">
								Ver meu resultado
							</button>
						</form>

						<div class="quiz-result" data-quiz-result hidden>
							<h3 class="quiz-result-title" data-result-title>Seu resultado</h3>
							<p class="quiz-result-text" data-result-text></p>
							<button class="quiz-reset" type="button" data-quiz-reset>
								Refazer o teste
							</button>
						</div>
					</div>
				</section>

				{/* ====== 2.5 SARCOPENIA + CREATINA (educacional) ====== */}
				<section class="section edu-section">
					<a href="/blog/category/suplementacao" class="edu-card-link">
						<article class="edu-card">
							<header class="edu-header">
								<span class="edu-eyebrow">Aprofunde-se</span>
								<h2 class="edu-title">
									Sarcopenia: o que a ciência diz (e como a creatina ajuda)
								</h2>
							</header>

							<div class="edu-body">
								<p>
									A <strong>sarcopenia</strong>, perda progressiva de massa
									e força muscular ligada ao envelhecimento, atinge cerca
									de{" "}
									<strong>1 em cada 3 brasileiros acima de 60 anos</strong>,
									segundo o estudo SABE (Saúde, Bem-estar e Envelhecimento)
									da USP. Ela está diretamente ligada a quedas, perda de
									independência e mortalidade precoce. Mas pode ser
									desacelerada (e em parte revertida) com duas intervenções
									simples: <strong>musculação regular</strong> e{" "}
									<strong>ingestão adequada de proteína</strong>.
								</p>

								<h3 class="edu-subtitle">O que a ciência mostra</h3>
								<p>
									Uma{" "}
									<strong>meta-análise de Chilibeck et al. (2017)</strong>{" "}
									reuniu 22 estudos com idosos e demonstrou que combinar
									creatina (3 a 5 g/dia) com treino de força 2 a 3x por
									semana resulta, em média, em <strong>1,4 kg a mais de
									massa muscular magra</strong> em comparação à musculação
									isolada. A revisão de{" "}
									<strong>Forbes et al. (2021)</strong> confirma o perfil de
									segurança da creatina em adultos 55+ e aponta ganhos
									adicionais em densidade óssea e desempenho cognitivo.
								</p>

								<h3 class="edu-subtitle">A creatina Douravita</h3>
								<div class="edu-product">
									<img
										src={creatinaPoteImg.src}
										alt="Pote da creatina monohidratada DouraVita 100% pura"
										class="edu-product-img"
										loading="lazy"
										width="320"
										height="320"
									/>
									<div class="edu-product-body">
										<p>
											A creatina monohidratada Douravita foi formulada
											pensando no público 55+: <strong>5 g por dia</strong>,
											sabor neutro, sem corantes nem aditivos
											desnecessários. Dissolve fácil em água, suco ou
											iogurte, e funciona melhor quando combinada com uma
											refeição rica em proteína e treino de força regular.
										</p>
										<a
											href={creatinaLaudoImg.src}
											target="_blank"
											rel="noopener"
											class="edu-laudo-link"
											onclick="event.stopPropagation();"
										>
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
												<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
												<polyline points="14 2 14 8 20 8"></polyline>
												<line x1="16" y1="13" x2="8" y2="13"></line>
												<line x1="16" y1="17" x2="8" y2="17"></line>
											</svg>
											<span>
												Veja o laudo analítico Eurofins
												<small>99,10% creatina monohidratada</small>
											</span>
										</a>
									</div>
								</div>
							</div>
						</article>
					</a>
				</section>

								{/* ====== 2.7 FERRAMENTAS (categoria, conteudo interativo) ====== */}
				<section class="section tools-section">
					<div class="tools-card">
						<header class="tools-header">
							<span class="tools-eyebrow">Ferramentas</span>
							<h2 class="tools-title">Teste-se, calcule, avalie</h2>
							<p class="tools-subtitle">
								Autoavaliações rápidas, calculadoras e checklists pensados pra
								quem tem 55+. Comece pela primeira disponível.
							</p>
						</header>
						<a href="#quiz-sarcopenia" class="tools-item">
							<span class="tools-item-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="4" width="18" height="16" rx="2"></rect>
									<path d="M9 9h6"></path>
									<path d="M9 13h6"></path>
									<path d="M9 17h3"></path>
								</svg>
							</span>
							<span class="tools-item-body">
								<span class="tools-item-eyebrow">Disponível agora</span>
								<span class="tools-item-title">Quiz: Você está em risco de sarcopenia?</span>
								<span class="tools-item-meta">6 perguntas · ~1 min</span>
							</span>
							<svg class="tools-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="12" y1="19" x2="12" y2="5"></line>
								<polyline points="5 12 12 5 19 12"></polyline>
							</svg>
						</a>
						<p class="tools-soon">Mais ferramentas chegando em breve.</p>
					</div>
				</section>

				{/* ====== 3. MAIS LIDOS ====== */}
				{mostReadWithCat.length > 0 && (
					<section class="section most-read">
						<header class="section-header">
							<h2 class="section-title">Mais lidos</h2>
						</header>
						<div class="most-read-grid">
							{mostReadWithCat.map(({ post, category }) => (
								<article class="card-tile">
									{post.data.featured_image && (
										<a
											href={`/blog/posts/${slugFor(post)}`}
											class="card-tile-image-link"
											aria-label={post.data.title}
										>
											<div class="card-tile-image">
												<Image image={post.data.featured_image} />
											</div>
										</a>
									)}
									<div class="card-tile-body">
										{category && (
											<a
												href={`/blog/category/${category.slug}`}
												class="badge"
											>
												{category.label}
											</a>
										)}
										<a
											href={`/blog/posts/${slugFor(post)}`}
											class="card-title-link"
										>
											<h3 class="card-tile-title">
												{post.data.title ?? "Sem título"}
											</h3>
										</a>
									</div>
								</article>
							))}
						</div>
					</section>
				)}

				{/* ====== 4.5 FRASE INSPIRADORA ====== */}
				<section class="inspirational-quote" aria-label="Mensagem">
					<div class="inspirational-quote-inner">
						<blockquote class="inspirational-quote-text">
							Cuidar de você é o melhor presente que você pode dar a quem te ama.
						</blockquote>
					</div>
				</section>

				{/* ====== 5. CONTEÚDOS RECENTES (só títulos) ====== */}
				{recentTitles.length > 0 && (
					<section class="section recent">
						<header class="section-header">
							<h2 class="section-title">Conteúdos mais recentes</h2>
						</header>
						<ul class="recent-list">
							{recentTitles.map((post) => (
								<li class="recent-item">
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="recent-link"
									>
										<h3 class="recent-title">
											{post.data.title ?? "Sem título"}
										</h3>
									</a>
									{post.data.publishedAt && (
										<time class="recent-date">
											Criado em{" "}
											{post.data.publishedAt.toLocaleDateString("pt-BR")}
										</time>
									)}
								</li>
							))}
						</ul>
					</section>
				)}

				{/* ====== 6. VER MAIS CONTEÚDOS ====== */}
				<section class="see-all-section">
					<a href="/blog/posts" class="see-all-btn">
						VER MAIS CONTEÚDOS <span aria-hidden="true">→</span>
					</a>
				</section>
			</div>
		)
	}

	<script>
		// Quiz de sarcopenia — score 0-6.
		// Faixas baseadas em SARC-F: 4+ indica risco significativo.
		const quiz = document.querySelector("[data-quiz]") as HTMLElement | null;
		if (quiz) {
			const form = quiz.querySelector(
				"[data-quiz-form]",
			) as HTMLFormElement | null;
			const result = quiz.querySelector(
				"[data-quiz-result]",
			) as HTMLElement | null;
			const titleEl = quiz.querySelector(
				"[data-result-title]",
			) as HTMLElement | null;
			const textEl = quiz.querySelector(
				"[data-result-text]",
			) as HTMLElement | null;
			const resetBtn = quiz.querySelector(
				"[data-quiz-reset]",
			) as HTMLButtonElement | null;

			form?.addEventListener("submit", (e) => {
				e.preventDefault();
				const fd = new FormData(form);
				let score = 0;
				let answered = 0;
				for (const [, v] of fd.entries()) {
					answered++;
					score += parseInt(v as string, 10) || 0;
				}
				if (answered < 6) {
					alert("Responda todas as perguntas para ver o resultado.");
					return;
				}
				let title = "";
				let text = "";
				if (score <= 1) {
					title = "Risco baixo";
					text =
						"Seus hábitos atuais protegem a massa muscular. Continue priorizando proteína, força e movimento regular.";
				} else if (score <= 3) {
					title = "Risco moderado";
					text =
						"Já existem sinais que vale a pena agir. Considere musculação 2-3x/semana, 1,2 g de proteína por kg/dia e exposição solar diária.";
				} else {
					title = "Risco alto";
					text =
						"Vários fatores aparecem no seu perfil. Procure um geriatra ou nutricionista — sarcopenia tem tratamento eficaz quando identificada cedo.";
				}
				if (titleEl) titleEl.textContent = `${title} — ${score}/6`;
				if (textEl) textEl.textContent = text;
				form.hidden = true;
				if (result) result.hidden = false;
			});

			resetBtn?.addEventListener("click", () => {
				form?.reset();
				if (form) form.hidden = false;
				if (result) result.hidden = true;
			});
		}
	</script>
</Base>

<style>
	/* ===== Globals ===== */
	.home-page-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-4) var(--spacing-16);
	}

	/* Intro de boas-vindas no topo da home — reforça que isto é o BLOG
	 * (sinal de SEO pra busca "blog douravita"). Visualmente discreta,
	 * separa-se do hero "Assuntos do momento" via borda inferior fina. */
	.home-intro {
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-6);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.home-intro-text {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 760px;
		margin-left: auto;
		margin-right: auto;
		text-align: center;
	}

	.home-intro-text strong {
		color: var(--color-text);
		font-weight: 700;
	}

	@media (min-width: 700px) {
		.home-intro-text {
			font-size: var(--font-size-lg);
		}
	}

	.section {
		margin-bottom: var(--spacing-16);
	}

	.section-header {
		margin-bottom: var(--spacing-6);
	}

	.section-title {
		font-size: var(--font-size-2xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-snug);
	}

	.badge {
		display: inline-block;
		align-self: start;
		padding: var(--tag-padding-y) var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-accent);
		background: var(--color-accent-ring, var(--color-surface));
		border-radius: 999px;
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.badge:hover {
		background: var(--color-border);
	}

	.card-title-link {
		text-decoration: none;
		color: inherit;
	}

	/* ===== 1. Assuntos do momento ===== */

	/* Mobile-first: 2 large empilhados + 3 small empilhados */
	.trending-large-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-8);
		margin-bottom: var(--spacing-8);
	}

	.card-large {
		display: flex;
		flex-direction: column;
	}

	.card-large-image-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-large-image {
		aspect-ratio: 16 / 9;
		max-height: 320px;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-3);
	}

	.card-large-image img {
		width: 100% !important;
