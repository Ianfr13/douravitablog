---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import CategoriesBar from "../components/CategoriesBar.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// 1 featured + 6 grid = 7 posts. +1 lookahead pra detectar "ver todos".
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Featured = primeiro post com imagem. Os outros 6 vão pro grid.
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;
const gridPosts = visiblePosts.filter((_, i) => i !== featuredIndex).slice(0, 6);

const entryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const categoriesByEntry = await getTermsForEntries("posts", entryIds, "category");

const featuredCategory = featuredPost
	? (categoriesByEntry.get(featuredPost.data.id) ?? [])[0]
	: undefined;

const gridPostsWithCategory = gridPosts.map((post) => ({
	post,
	category: ((categoriesByEntry.get(post.data.id) ?? [])[0]) as
		| { slug: string; label: string }
		| undefined,
}));
---

<Base title={siteTitle} description={siteTagline}>
	<h1 class="home-page-heading">{siteTitle}</h1>
	{
		posts.length === 0 ? (
			<section class="empty-state">
				<h2>Nenhum artigo ainda</h2>
				<p>Crie seu primeiro artigo no painel administrativo.</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">
					Criar um artigo
				</a>
			</section>
		) : (
			<div class="home-content">
				{/* Featured Post — destaque grande, imagem ao lado + categoria/título/excerpt */}
				{featuredPost && (
					<section class="featured-section">
						<div class="featured-grid">
							<a href={`/blog/posts/${featuredPost.slug ?? featuredPost.id}`} class="featured-image-link">
								<div class="featured-image">
									<Image image={featuredPost.data.featured_image} />
								</div>
							</a>
							<div class="featured-content">
								{featuredCategory && (
									<a
										href={`/blog/category/${featuredCategory.slug}`}
										class="featured-category"
									>
										{featuredCategory.label}
									</a>
								)}
								<a
									href={`/blog/posts/${featuredPost.slug ?? featuredPost.id}`}
									class="featured-title-link"
								>
									<h2 class="featured-title">{featuredPost.data.title}</h2>
								</a>
								{featuredPost.data.excerpt && (
									<p class="featured-excerpt">{featuredPost.data.excerpt}</p>
								)}
							</div>
						</div>
					</section>
				)}

				{/* Categories bar */}
				<CategoriesBar />

				{/* Main grid: 2 colunas, cards grandes estilo tuasaude.
				 * Imagem 16:9 no topo + categoria + título + excerpt. */}
				{gridPostsWithCategory.length > 0 && (
					<section class="posts-section">
						<header class="section-header">
							<h2 class="section-title">Conteúdos mais recentes</h2>
							{hasMorePosts && (
								<a href="/blog/posts" class="section-link">
									Ver todos
								</a>
							)}
						</header>
						<div class="home-grid">
							{gridPostsWithCategory.map(({ post, category }) => (
								<article class="home-card">
									{post.data.featured_image && (
										<a
											href={`/blog/posts/${post.slug ?? post.id}`}
											class="home-card-image-link"
											aria-label={post.data.title}
										>
											<div class="home-card-image">
												<Image image={post.data.featured_image} />
											</div>
										</a>
									)}
									<div class="home-card-body">
										{category && (
											<a
												href={`/blog/category/${category.slug}`}
												class="home-card-category"
											>
												{category.label}
											</a>
										)}
										<a
											href={`/blog/posts/${post.slug ?? post.id}`}
											class="home-card-title-link"
										>
											<h3 class="home-card-title">
												{post.data.title ?? "Sem título"}
											</h3>
										</a>
										{post.data.excerpt && (
											<p class="home-card-excerpt">{post.data.excerpt}</p>
										)}
									</div>
								</article>
							))}
						</div>
					</section>
				)}
			</div>
		)
	}
</Base>

<style>
	.home-page-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	/* Featured Section */
	.featured-section {
		margin-bottom: var(--spacing-16);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-8);
		align-items: center;
	}

	.featured-image-link {
		grid-column: 1 / 3;
		display: block;
	}

	.featured-image {
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.featured-image img {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	@media (min-width: 901px) {
		.featured-image,
		.featured-image img {
			max-height: 420px;
		}
	}

	.featured-image-link:hover .featured-image img,
	.featured-grid:has(.featured-title-link:hover) .featured-image img {
		transform: scale(1.02);
	}

	.featured-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.featured-title-link {
		text-decoration: none;
		color: inherit;
	}

	.featured-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		transition: color var(--transition-fast);
	}

	.featured-title-link:hover .featured-title,
	.featured-grid:has(.featured-image-link:hover) .featured-title {
		color: var(--color-accent);
	}

	.featured-excerpt {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.featured-category {
		display: inline-block;
		align-self: start;
		padding: var(--tag-padding-y) var(--spacing-3);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-accent);
		background: var(--color-accent-ring, var(--color-surface));
		border-radius: var(--radius);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.featured-category:hover {
		background: var(--color-border);
	}

	/* Section header */
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-title {
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
	}

	.section-link {
		font-size: var(--font-size-sm);
		color: var(--color-accent);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.section-link:hover {
		color: var(--color-accent-hover);
	}

	/* Home grid — estilo tuasaude: 2 colunas, imagem grande no topo */
	.home-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-12) var(--spacing-10);
	}

	.home-card {
		display: flex;
		flex-direction: column;
	}

	.home-card-image-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.home-card-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
	}

	.home-card-image img {
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
		transition: transform 0.3s ease;
	}

	.home-card-image-link:hover .home-card-image img {
		transform: scale(1.03);
	}

	.home-card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.home-card-category {
		display: inline-block;
		align-self: start;
		padding: var(--tag-padding-y) var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-accent);
		background: var(--color-accent-ring, var(--color-surface));
		border-radius: var(--radius);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.home-card-category:hover {
		background: var(--color-border);
	}

	.home-card-title-link {
		text-decoration: none;
		color: inherit;
	}

	.home-card-title {
		font-size: var(--font-size-2xl);
		font-weight: 700;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		transition: color var(--transition-fast);
	}

	.home-card-title-link:hover .home-card-title {
		color: var(--color-accent);
	}

	.home-card-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Empty state */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state h2 {
		font-size: var(--font-size-2xl);
		font-weight: 600;
	}

	.empty-state p {
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-accent);
		color: var(--color-on-accent);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 500;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-accent-hover);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.home-content {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.featured-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-6);
		}

		.featured-image img {
			aspect-ratio: 16 / 9;
		}

		.home-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-10);
		}
	}

	@media (max-width: 600px) {
		.featured-title {
			font-size: var(--font-size-2xl);
		}

		.home-card-title {
			font-size: var(--font-size-xl);
		}
	}
</style>
