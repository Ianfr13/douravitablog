---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Fetch generoso: 30 posts em DESC. Vamos splittar em "momento" (5 mais
// recentes), "mais lidos" (8 mais antigos) e "recentes" (6 do meio sem
// repetir). Em produção (~21 posts) cabe tudo sem N+1.
const POSTS_TO_FETCH = 30;

const [{ entries: allPosts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_TO_FETCH,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

// Section 1 — Assuntos do momento: 2 large + 3 small (5 mais recentes)
const trending = allPosts.slice(0, 5);
const trendingLarge = trending.slice(0, 2);
const trendingSmall = trending.slice(2, 5);
const usedIds = new Set(trending.map((p) => p.data.id));

// Section 3 — Mais lidos: 8 mais antigos (proxy de "tempo exposto")
const mostRead: typeof allPosts = [];
for (let i = allPosts.length - 1; i >= 0 && mostRead.length < 8; i--) {
	const post = allPosts[i];
	if (usedIds.has(post.data.id)) continue;
	mostRead.push(post);
	usedIds.add(post.data.id);
}

// Section 5 — Conteúdos recentes (só títulos): 6 do meio sem repetir
const recentTitles: typeof allPosts = [];
for (const post of allPosts) {
	if (recentTitles.length >= 6) break;
	if (usedIds.has(post.data.id)) continue;
	recentTitles.push(post);
	usedIds.add(post.data.id);
}

// Batch query: categorias dos posts que aparecem como card (não dos só-título)
const cardIds = [
	...trending.map((p) => p.data.id),
	...mostRead.map((p) => p.data.id),
];
const categoriesByEntry = await getTermsForEntries(
	"posts",
	cardIds,
	"category",
);

type CategoryRef = { slug: string; label: string };

function withCategory(post: typeof allPosts[0]) {
	return {
		post,
		category: ((categoriesByEntry.get(post.data.id) ?? [])[0]) as
			| CategoryRef
			| undefined,
	};
}

const trendingLargeWithCat = trendingLarge.map(withCategory);
const trendingSmallWithCat = trendingSmall.map(withCategory);
const mostReadWithCat = mostRead.map(withCategory);

// Section 4 — Recomendações de palavras-chave por categoria.
// Derivado de src/pilares.py (subtópicos dos 12 pilares). Linka pra
// /blog/search?q=<keyword> — endpoint existente em pages/search.astro.
const keywordsByCategory: {
	slug: string;
	label: string;
	keywords: string[];
}[] = [
	{
		slug: "suplementacao",
		label: "Suplementação",
		keywords: [
			"creatina",
			"whey protein",
			"vitamina D",
			"ômega 3",
			"colágeno",
			"magnésio",
		],
	},
	{
		slug: "movimento",
		label: "Movimento",
		keywords: [
			"musculação 55+",
			"caminhada",
			"yoga",
			"alongamento",
			"prevenção de quedas",
			"exercícios em casa",
		],
	},
	{
		slug: "nutricao",
		label: "Nutrição",
		keywords: [
			"proteína por dia",
			"dieta mediterrânea",
			"hidratação",
			"jejum intermitente",
			"cálcio",
			"vitamina B12",
		],
	},
	{
		slug: "saude-mental",
		label: "Saúde Mental",
		keywords: [
			"memória",
			"sono",
			"ansiedade",
			"depressão",
			"demência",
			"Alzheimer",
		],
	},
	{
		slug: "mulher-55",
		label: "Saúde da Mulher",
		keywords: [
			"menopausa",
			"climatério",
			"osteoporose",
			"reposição hormonal",
			"incontinência",
		],
	},
	{
		slug: "homem-55",
		label: "Saúde do Homem",
		keywords: [
			"próstata",
			"testosterona",
			"andropausa",
			"PSA",
			"cardiologia preventiva",
		],
	},
	{
		slug: "doencas-cronicas",
		label: "Doenças Crônicas",
		keywords: [
			"diabetes tipo 2",
			"hipertensão",
			"artrose",
			"colesterol",
			"AVC",
			"refluxo",
		],
	},
	{
		slug: "pele-e-estetica",
		label: "Pele e Estética",
		keywords: [
			"flacidez",
			"manchas",
			"queda de cabelo",
			"próteses dentárias",
			"colágeno",
		],
	},
	{
		slug: "vida-plena",
		label: "Vida Plena",
		keywords: [
			"solidão",
			"viagem 55+",
			"finanças",
			"netos",
			"voluntariado",
			"sexo na maturidade",
		],
	},
	{
		slug: "ciencia",
		label: "Ciência",
		keywords: [
			"Blue Zones",
			"longevidade",
			"idade biológica",
			"jejum 16h",
			"biohacking",
		],
	},
	{
		slug: "cuidador",
		label: "Cuidador",
		keywords: [
			"cuidar do pai",
			"cuidar da mãe",
			"polifarmácia",
			"casa segura",
			"sinais de alerta",
		],
	},
	{
		slug: "noticias",
		label: "Notícias",
		keywords: [
			"alerta Anvisa",
			"novo estudo",
			"recall",
			"Outubro Rosa",
			"Novembro Azul",
		],
	},
];

// Quiz de sarcopenia: 6 perguntas sim/não. JS calcula score no client.
// Critérios baseados em SARC-F (validado) + fatores de risco comuns 55+.
const sarcQuestions = [
	"Tenho 65 anos ou mais",
	"Sinto fraqueza ou dor nas pernas ao subir escadas",
	"Perdi mais de 3 kg sem querer nos últimos 6 meses",
	"Fico mais de 6 horas por dia sentado(a) ou parado(a)",
	"NÃO faço exercícios de força (musculação) pelo menos 2 vezes por semana",
	"Tenho dificuldade em abrir potes ou garrafas que abria fácil antes",
];

const slugFor = (post: typeof allPosts[0]) => post.slug ?? post.id;
---

<Base title={siteTitle} description={siteTagline}>
	<h1 class="home-page-heading">{siteTitle}</h1>

	{
		allPosts.length === 0 ? (
			<section class="empty-state">
				<h2>Nenhum artigo ainda</h2>
				<p>Crie seu primeiro artigo no painel administrativo.</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">
					Criar um artigo
				</a>
			</section>
		) : (
			<div class="home-content">
				{/* ====== 1. ASSUNTOS DO MOMENTO ====== */}
				<section class="section trending">
					<header class="section-header">
						<h2 class="section-title">Assuntos do momento</h2>
					</header>

					<div class="trending-large-grid">
						{trendingLargeWithCat.map(({ post, category }) => (
							<article class="card-large">
								{post.data.featured_image && (
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-large-image-link"
										aria-label={post.data.title}
									>
										<div class="card-large-image">
											<Image image={post.data.featured_image} />
										</div>
									</a>
								)}
								<div class="card-large-body">
									{category && (
										<a
											href={`/blog/category/${category.slug}`}
											class="badge"
										>
											{category.label}
										</a>
									)}
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-title-link"
									>
										<h3 class="card-large-title">
											{post.data.title ?? "Sem título"}
										</h3>
									</a>
									{post.data.excerpt && (
										<p class="card-large-excerpt">{post.data.excerpt}</p>
									)}
								</div>
							</article>
						))}
					</div>

					<div class="trending-small-list">
						{trendingSmallWithCat.map(({ post, category }) => (
							<article class="card-small">
								{post.data.featured_image && (
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-small-image-link"
										aria-label={post.data.title}
									>
										<Image image={post.data.featured_image} />
									</a>
								)}
								<div class="card-small-body">
									{category && (
										<a
											href={`/blog/category/${category.slug}`}
											class="badge"
										>
											{category.label}
										</a>
									)}
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="card-title-link"
									>
										<h3 class="card-small-title">
											{post.data.title ?? "Sem título"}
										</h3>
									</a>
								</div>
							</article>
						))}
					</div>
				</section>

				{/* ====== 2. QUIZ INTERATIVO: SARCOPENIA ====== */}
				<section class="section quiz-section">
					<div class="quiz-card" data-quiz>
						<header class="quiz-header">
							<span class="quiz-eyebrow">Conteúdo interativo</span>
							<h2 class="quiz-title">Você está em risco de sarcopenia?</h2>
							<p class="quiz-subtitle">
								Sarcopenia é a perda de massa e força muscular ligada ao
								envelhecimento. Responda 6 perguntas rápidas e descubra seu
								nível de risco.
							</p>
						</header>

						<form class="quiz-form" data-quiz-form>
							{sarcQuestions.map((q, i) => (
								<fieldset class="quiz-question">
									<legend class="quiz-q-text">
										<span class="quiz-q-num">{i + 1}.</span> {q}
									</legend>
									<div class="quiz-q-options">
										<label class="quiz-option">
											<input type="radio" name={`q${i}`} value="1" />
											<span>Sim</span>
										</label>
										<label class="quiz-option">
											<input type="radio" name={`q${i}`} value="0" />
											<span>Não</span>
										</label>
									</div>
								</fieldset>
							))}

							<button type="submit" class="quiz-submit">
								Ver meu resultado
							</button>
						</form>

						<div class="quiz-result" data-quiz-result hidden>
							<h3 class="quiz-result-title" data-result-title></h3>
							<p class="quiz-result-text" data-result-text></p>
							<button class="quiz-reset" type="button" data-quiz-reset>
								Refazer o teste
							</button>
						</div>
					</div>
				</section>

				{/* ====== 3. MAIS LIDOS ====== */}
				{mostReadWithCat.length > 0 && (
					<section class="section most-read">
						<header class="section-header">
							<h2 class="section-title">Mais lidos</h2>
						</header>
						<div class="most-read-grid">
							{mostReadWithCat.map(({ post, category }) => (
								<article class="card-tile">
									{post.data.featured_image && (
										<a
											href={`/blog/posts/${slugFor(post)}`}
											class="card-tile-image-link"
											aria-label={post.data.title}
										>
											<div class="card-tile-image">
												<Image image={post.data.featured_image} />
											</div>
										</a>
									)}
									<div class="card-tile-body">
										{category && (
											<a
												href={`/blog/category/${category.slug}`}
												class="badge"
											>
												{category.label}
											</a>
										)}
										<a
											href={`/blog/posts/${slugFor(post)}`}
											class="card-title-link"
										>
											<h3 class="card-tile-title">
												{post.data.title ?? "Sem título"}
											</h3>
										</a>
									</div>
								</article>
							))}
						</div>
					</section>
				)}

				{/* ====== 4. PALAVRAS-CHAVE POR CATEGORIA ====== */}
				<section class="section keywords">
					<header class="section-header">
						<h2 class="section-title">Explore por assunto</h2>
					</header>
					<div class="keywords-grid">
						{keywordsByCategory.map((cat) => (
							<div class="kw-block">
								<a href={`/blog/category/${cat.slug}`} class="kw-cat-title">
									{cat.label.toUpperCase()} <span class="kw-arrow">→</span>
								</a>
								<div class="kw-pills">
									{cat.keywords.map((kw) => (
										<a
											href={`/blog/search?q=${encodeURIComponent(kw)}`}
											class="kw-pill"
										>
											{kw}
										</a>
									))}
								</div>
							</div>
						))}
					</div>
				</section>

				{/* ====== 5. CONTEÚDOS RECENTES (só títulos) ====== */}
				{recentTitles.length > 0 && (
					<section class="section recent">
						<header class="section-header">
							<h2 class="section-title">Conteúdos mais recentes</h2>
						</header>
						<ul class="recent-list">
							{recentTitles.map((post) => (
								<li class="recent-item">
									<a
										href={`/blog/posts/${slugFor(post)}`}
										class="recent-link"
									>
										<h3 class="recent-title">
											{post.data.title ?? "Sem título"}
										</h3>
									</a>
									{post.data.publishedAt && (
										<time class="recent-date">
											Criado em{" "}
											{post.data.publishedAt.toLocaleDateString("pt-BR")}
										</time>
									)}
								</li>
							))}
						</ul>
					</section>
				)}

				{/* ====== 6. VER MAIS CONTEÚDOS ====== */}
				<section class="see-all-section">
					<a href="/blog/posts" class="see-all-btn">
						VER MAIS CONTEÚDOS <span aria-hidden="true">→</span>
					</a>
				</section>
			</div>
		)
	}

	<script>
		// Quiz de sarcopenia — score 0-6.
		// Faixas baseadas em SARC-F: 4+ indica risco significativo.
		const quiz = document.querySelector("[data-quiz]") as HTMLElement | null;
		if (quiz) {
			const form = quiz.querySelector(
				"[data-quiz-form]",
			) as HTMLFormElement | null;
			const result = quiz.querySelector(
				"[data-quiz-result]",
			) as HTMLElement | null;
			const titleEl = quiz.querySelector(
				"[data-result-title]",
			) as HTMLElement | null;
			const textEl = quiz.querySelector(
				"[data-result-text]",
			) as HTMLElement | null;
			const resetBtn = quiz.querySelector(
				"[data-quiz-reset]",
			) as HTMLButtonElement | null;

			form?.addEventListener("submit", (e) => {
				e.preventDefault();
				const fd = new FormData(form);
				let score = 0;
				let answered = 0;
				for (const [, v] of fd.entries()) {
					answered++;
					score += parseInt(v as string, 10) || 0;
				}
				if (answered < 6) {
					alert("Responda todas as perguntas para ver o resultado.");
					return;
				}
				let title = "";
				let text = "";
				if (score <= 1) {
					title = "Risco baixo";
					text =
						"Seus hábitos atuais protegem a massa muscular. Continue priorizando proteína, força e movimento regular.";
				} else if (score <= 3) {
					title = "Risco moderado";
					text =
						"Já existem sinais que vale a pena agir. Considere musculação 2-3x/semana, 1,2 g de proteína por kg/dia e exposição solar diária.";
				} else {
					title = "Risco alto";
					text =
						"Vários fatores aparecem no seu perfil. Procure um geriatra ou nutricionista — sarcopenia tem tratamento eficaz quando identificada cedo.";
				}
				if (titleEl) titleEl.textContent = `${title} — ${score}/6`;
				if (textEl) textEl.textContent = text;
				form.hidden = true;
				if (result) result.hidden = false;
			});

			resetBtn?.addEventListener("click", () => {
				form?.reset();
				if (form) form.hidden = false;
				if (result) result.hidden = true;
			});
		}
	</script>
</Base>

<style>
	/* ===== Globals ===== */
	.home-page-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-4) var(--spacing-16);
	}

	.section {
		margin-bottom: var(--spacing-16);
	}

	.section-header {
		margin-bottom: var(--spacing-6);
	}

	.section-title {
		font-size: var(--font-size-2xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-snug);
	}

	.badge {
		display: inline-block;
		align-self: start;
		padding: var(--tag-padding-y) var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-accent);
		background: var(--color-accent-ring, var(--color-surface));
		border-radius: 999px;
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.badge:hover {
		background: var(--color-border);
	}

	.card-title-link {
		text-decoration: none;
		color: inherit;
	}

	/* ===== 1. Assuntos do momento ===== */

	/* Mobile-first: 2 large empilhados + 3 small empilhados */
	.trending-large-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-8);
		margin-bottom: var(--spacing-8);
	}

	.card-large {
		display: flex;
		flex-direction: column;
	}

	.card-large-image-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-large-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-3);
	}

	.card-large-image img {
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
		transition: transform 0.3s ease;
	}

	.card-large-image-link:hover .card-large-image img {
		transform: scale(1.03);
	}

	.card-large-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.card-large-title {
		font-size: var(--font-size-xl);
		font-weight: 700;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		transition: color var(--transition-fast);
	}

	.card-title-link:hover .card-large-title,
	.card-title-link:hover .card-small-title,
	.card-title-link:hover .card-tile-title {
		color: var(--color-accent);
	}

	.card-large-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.trending-small-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
	}

	.card-small {
		display: grid;
		grid-template-columns: 110px 1fr;
		gap: var(--spacing-3);
		align-items: start;
	}

	.card-small-image-link {
		display: block;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.card-small-image-link img {
		width: 100% !important;
		height: 100% !important;
		aspect-ratio: 4 / 3;
		object-fit: cover !important;
		transition: transform 0.3s ease;
	}

	.card-small-image-link:hover img {
		transform: scale(1.04);
	}

	.card-small-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		min-width: 0;
	}

	.card-small-title {
		font-size: var(--font-size-base);
		font-weight: 600;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		transition: color var(--transition-fast);
	}

	/* ===== 2. Quiz ===== */
	.quiz-card {
		background: var(--color-bg-subtle, var(--color-surface));
		border-radius: var(--radius-lg);
		padding: var(--spacing-6) var(--spacing-5);
		border: 1px solid var(--color-border-subtle);
	}

	.quiz-header {
		margin-bottom: var(--spacing-5);
	}

	.quiz-eyebrow {
		display: inline-block;
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-accent);
		margin-bottom: var(--spacing-2);
	}

	.quiz-title {
		font-size: var(--font-size-2xl);
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

