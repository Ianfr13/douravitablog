---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import CategoriesBar from "../components/CategoriesBar.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// 6 cards no topo (2 large + 4 small) + 4 itens lista compacta + 1 lookahead.
const POSTS_PER_PAGE = 10;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// 6 cards superiores: 2 large + 4 small. Compact list: 4 títulos seguintes.
const largeCards = visiblePosts.slice(0, 2);
const smallCards = visiblePosts.slice(2, 6);
const compactList = visiblePosts.slice(6, 10);

const cardEntryIds = [
	...largeCards.map((p) => p.data.id),
	...smallCards.map((p) => p.data.id),
];
const categoriesByEntry = await getTermsForEntries(
	"posts",
	cardEntryIds,
	"category",
);

function withCategory(post: typeof visiblePosts[0]) {
	return {
		post,
		category: ((categoriesByEntry.get(post.data.id) ?? [])[0]) as
			| { slug: string; label: string }
			| undefined,
	};
}

const largeCardsWithCategory = largeCards.map(withCategory);
const smallCardsWithCategory = smallCards.map(withCategory);
---

<Base title={siteTitle} description={siteTagline}>
	<h1 class="home-page-heading">{siteTitle}</h1>
	{
		posts.length === 0 ? (
			<section class="empty-state">
				<h2>Nenhum artigo ainda</h2>
				<p>Crie seu primeiro artigo no painel administrativo.</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">
					Criar um artigo
				</a>
			</section>
		) : (
			<div class="home-content">
				{/* Top: 2 cards grandes lado a lado, imagem 16:9 no topo */}
				{largeCardsWithCategory.length > 0 && (
					<section class="large-cards-section">
						<div class="large-cards-grid">
							{largeCardsWithCategory.map(({ post, category }) => (
								<article class="large-card">
									{post.data.featured_image && (
										<a
											href={`/blog/posts/${post.slug ?? post.id}`}
											class="large-card-image-link"
											aria-label={post.data.title}
										>
											<div class="large-card-image">
												<Image image={post.data.featured_image} />
											</div>
										</a>
									)}
									<div class="large-card-body">
										{category && (
											<a
												href={`/blog/category/${category.slug}`}
												class="large-card-category"
											>
												{category.label}
											</a>
										)}
										<a
											href={`/blog/posts/${post.slug ?? post.id}`}
											class="large-card-title-link"
										>
											<h2 class="large-card-title">
												{post.data.title ?? "Sem título"}
											</h2>
										</a>
										{post.data.excerpt && (
											<p class="large-card-excerpt">{post.data.excerpt}</p>
										)}
									</div>
								</article>
							))}
						</div>
					</section>
				)}

				{/* 4 cards menores: imagem lateral pequena */}
				{smallCardsWithCategory.length > 0 && (
					<section class="small-cards-section">
						<div class="small-cards-grid">
							{smallCardsWithCategory.map(({ post, category }) => (
								<article class="small-card">
									{post.data.featured_image && (
										<a
											href={`/blog/posts/${post.slug ?? post.id}`}
											class="small-card-image-link"
											aria-label={post.data.title}
										>
											<Image image={post.data.featured_image} />
										</a>
									)}
									<div class="small-card-body">
										{category && (
											<a
												href={`/blog/category/${category.slug}`}
												class="small-card-category"
											>
												{category.label}
											</a>
										)}
										<a
											href={`/blog/posts/${post.slug ?? post.id}`}
											class="small-card-title-link"
										>
											<h3 class="small-card-title">
												{post.data.title ?? "Sem título"}
											</h3>
										</a>
										{post.data.excerpt && (
											<p class="small-card-excerpt">{post.data.excerpt}</p>
										)}
									</div>
								</article>
							))}
						</div>
					</section>
				)}

				<CategoriesBar />

				{/* Lista compacta: só títulos clicáveis dos próximos posts */}
				{compactList.length > 0 && (
					<section class="posts-section">
						<header class="section-header">
							<h2 class="section-title">Conteúdos mais recentes</h2>
							{hasMorePosts && (
								<a href="/blog/posts" class="section-link">
									Ver todos
								</a>
							)}
						</header>
						<ul class="posts-list-compact">
							{compactList.map((post) => (
								<li class="posts-list-item">
									<a
										href={`/blog/posts/${post.slug ?? post.id}`}
										class="posts-list-title-link"
									>
										<h3 class="posts-list-title">
											{post.data.title ?? "Sem título"}
										</h3>
									</a>
									{post.data.publishedAt && (
										<time class="posts-list-date">
											{post.data.publishedAt.toLocaleDateString("pt-BR")}
										</time>
									)}
								</li>
							))}
						</ul>
					</section>
				)}
			</div>
		)
	}
</Base>

<style>
	.home-page-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6);
	}

	/* Large cards (2 topo) — imagem 16:9 grande no topo */
	.large-cards-section {
		margin-bottom: var(--spacing-12);
	}

	.large-cards-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-10);
	}

	.large-card {
		display: flex;
		flex-direction: column;
	}

	.large-card-image-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.large-card-image {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
	}

	.large-card-image img {
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
		transition: transform 0.3s ease;
	}

	.large-card-image-link:hover .large-card-image img {
		transform: scale(1.03);
	}

	.large-card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.large-card-category {
		display: inline-block;
		align-self: start;
		padding: var(--tag-padding-y) var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-accent);
		background: var(--color-accent-ring, var(--color-surface));
		border-radius: var(--radius);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.large-card-category:hover {
		background: var(--color-border);
	}

	.large-card-title-link {
		text-decoration: none;
		color: inherit;
	}

	.large-card-title {
		font-size: clamp(var(--font-size-xl), 2.6vw, var(--font-size-2xl));
		font-weight: 700;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		transition: color var(--transition-fast);
	}

	.large-card-title-link:hover .large-card-title {
		color: var(--color-accent);
	}

	.large-card-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Small cards (4 abaixo) — imagem lateral pequena, estilo Tua Saude */
	.small-cards-section {
		margin-bottom: var(--spacing-16);
	}

	.small-cards-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-8);
	}

	.small-card {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: var(--spacing-4);
		align-items: start;
	}

	.small-card-image-link {
		display: block;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
	}

	.small-card-image-link img {
		width: 100% !important;
		height: 100% !important;
		aspect-ratio: 4 / 3;
		object-fit: cover !important;
		transition: transform 0.3s ease;
	}

	.small-card-image-link:hover img {
		transform: scale(1.04);
	}

	.small-card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		min-width: 0;
	}

	.small-card-category {
		display: inline-block;
		align-self: start;
		padding: var(--tag-padding-y) var(--spacing-3);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-accent);
		background: var(--color-accent-ring, var(--color-surface));
		border-radius: var(--radius);
		text-decoration: none;
		transition: background var(--transition-fast);
	}

	.small-card-category:hover {
		background: var(--color-border);
	}

	.small-card-title-link {
		text-decoration: none;
		color: inherit;
	}

	.small-card-title {
		font-size: var(--font-size-lg);
		font-weight: 700;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		transition: color var(--transition-fast);
	}

	.small-card-title-link:hover .small-card-title {
		color: var(--color-accent);
	}

	.small-card-excerpt {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Section header (lista compacta) */
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-title {
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
	}

	.section-link {
		font-size: var(--font-size-sm);
		color: var(--color-accent);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.section-link:hover {
		color: var(--color-accent-hover);
	}

	/* Lista compacta de títulos clicáveis */
	.posts-list-compact {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.posts-list-item {
		padding: var(--spacing-5) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.posts-list-item:last-child {
		border-bottom: none;
	}

	.posts-list-title-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.posts-list-title {
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-1);
		transition: color var(--transition-fast);
	}

	.posts-list-title-link:hover .posts-list-title {
		color: var(--color-accent);
	}

	.posts-list-date {
		display: block;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	/* Empty state */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state h2 {
		font-size: var(--font-size-2xl);
		font-weight: 600;
	}

	.empty-state p {
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-accent);
		color: var(--color-on-accent);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 500;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-accent-hover);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.home-content {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.large-cards-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}

		.small-cards-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-6);
		}
	}

	@media (max-width: 600px) {
		.large-card-title {
			font-size: var(--font-size-xl);
		}

		.small-card {
			grid-template-columns: 110px 1fr;
			gap: var(--spacing-3);
		}

		.small-card-title {
			font-size: var(--font-size-base);
		}

		.small-card-excerpt {
			display: none;
		}
	}
</style>
