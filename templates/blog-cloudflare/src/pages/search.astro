---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// Use the FTS-backed search() API instead of loading every post and
// filtering in JS. FTS scales as the post count grows, returns ranked
// results, and handles tokenization/stemming. Templates that grep all
// post bodies in JS quickly become unusable past a few hundred posts.
const { items: results } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [] };

function sanitizeSearchSnippet(snippet: string) {
	return snippet
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#39;")
		.replace(/&lt;mark&gt;/g, "<mark>")
		.replace(/&lt;\/mark&gt;/g, "</mark>");
}
---

<Base
	title={query ? `Busca: ${query}` : "Buscar"}
	description="Buscar artigos do blog"
	robots="noindex, follow"
>
	<section class="search-page">
		<h1 class="search-title">Buscar</h1>

		<form method="get" action="/blog/search" class="search-form">
			<input
				type="search"
				name="q"
				value={query}
				placeholder="Buscar artigos..."
				class="search-input"
				autofocus
			/>
			<button type="submit" class="search-button">Buscar</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{results.length === 0
						? `Nenhum resultado para "${query}"`
						: `${results.length} resultado${results.length === 1 ? "" : "s"} para "${query}"`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="search-results">
					{results.map((result) => {
						const safeSnippet = result.snippet
							? sanitizeSearchSnippet(result.snippet)
							: null;

						return (
							<li class="search-result">
								<a
									href={`/blog/posts/${result.slug ?? result.id}`}
									class="result-link"
								>
									<h2 class="result-title">
										{result.title ?? "Sem título"}
									</h2>
									{safeSnippet && (
										<p class="result-snippet" set:html={safeSnippet} />
									)}
								</a>
							</li>
						);
					})}
				</ol>
			)
		}

		{!query && <p class="search-hint">Digite um termo para buscar artigos.</p>}
	</section>
</Base>

<style>
	.search-page {
		max-width: 920px;
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.search-title {
		font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-5xl));
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: -0.035em;
		margin-bottom: var(--spacing-6);
		padding: var(--spacing-8);
		border: 1px solid var(--color-border-subtle);
		border-radius: calc(var(--radius-lg) * 2);
		background: color-mix(in oklch, var(--color-accent) 5%, var(--color-bg));
	}

	.search-form {
		display: flex;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-8);
		padding: var(--spacing-3);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		background: color-mix(in oklch, var(--color-bg) 86%, var(--color-surface));
	}

	.search-input {
		flex: 1;
		min-height: 52px;
		padding: 0 var(--spacing-4);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 3px var(--color-accent-ring);
	}

	.search-button {
		min-height: 52px;
		padding: 0 var(--spacing-6);
		font-size: var(--font-size-base);
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: none;
		border-radius: var(--radius);
		cursor: pointer;
		font-weight: 700;
		transition: background var(--transition-fast), transform var(--transition-fast);
	}

	.search-button:hover {
		background: var(--color-accent-hover);
		transform: translateY(-1px);
	}

	.search-summary {
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-6);
		font-size: var(--font-size-lg);
	}

	.search-hint {
		padding: var(--spacing-6);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		color: var(--color-text-secondary);
	}

	.search-results {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.search-result {
		padding: var(--spacing-5);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
	}

	.search-result:hover {
		border-color: var(--color-border);
		background: color-mix(in oklch, var(--color-bg) 88%, var(--color-surface));
		transform: translateY(-1px);
	}

	.result-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.result-title {
		font-size: var(--font-size-xl);
		font-weight: 700;
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.result-link:hover .result-title {
		color: var(--color-accent-hover);
	}

	.result-snippet {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* FTS returns <mark> wrapping the matched terms */
	.result-snippet :global(mark) {
		background: color-mix(in oklch, var(--color-accent) 18%, var(--color-bg));
		color: var(--color-text);
		padding: 0 0.12em;
		border-radius: 2px;
	}

	@media (max-width: 640px) {
		.search-page {
			padding: var(--spacing-8) var(--spacing-4) var(--spacing-12);
		}

		.search-form {
			flex-direction: column;
		}
	}
</style>
