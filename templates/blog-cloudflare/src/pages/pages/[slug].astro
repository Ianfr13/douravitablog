---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

// rewrite (nao redirect): ver comentario em posts/[slug].astro.
if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Edge cache: ver comentario em posts/[slug].astro.
Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);

// A collection `pages` no EmDash so tem title + content (sem campo
// description). Pra nao deixar meta description vazia (e <title> sem
// snippet bom no SERP/WhatsApp preview), extraimos do primeiro paragrafo
// nao-vazio do PortableText. Limite ~155 chars (recomendacao SERP).
function extractDescription(content: any, maxChars = 155): string | null {
	if (!Array.isArray(content)) return null;
	let text = "";
	for (const block of content) {
		if (block?._type !== "block") continue;
		const blockText = (block.children || [])
			.map((c: any) => (c && typeof c.text === "string") ? c.text : "")
			.join("")
			.trim();
		if (!blockText) continue;
		text += (text ? " " : "") + blockText;
		if (text.length >= maxChars) break;
	}
	if (!text) return null;
	if (text.length > maxChars) {
		text = text.slice(0, maxChars - 1).replace(/\s+\S*$/, "") + "…";
	}
	return text;
}
const description = extractDescription(page.data.content);
---

<Base
	title={page.data.title}
	description={description}
	content={{ collection: "pages", id: page.data.id, slug }}
	canonical={`${Astro.url.origin}/blog/pages/${slug}`}
>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>

		<div class="page-content">
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
		padding: var(--spacing-8);
		border: 1px solid var(--color-border-subtle);
		border-radius: calc(var(--radius-lg) * 2);
		background: color-mix(in oklch, var(--color-accent) 4%, var(--color-bg));
	}

	.page-title {
		font-size: clamp(var(--font-size-3xl), 5vw, var(--font-size-5xl));
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: -0.035em;
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2em;
		margin-bottom: 0.75em;
	}

	.page-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(blockquote) {
		margin: 1.5em 0;
		padding: var(--spacing-5) var(--spacing-6);
		border: 1px solid color-mix(in oklch, var(--color-accent) 16%, var(--color-border));
		background: color-mix(in oklch, var(--color-accent) 5%, var(--color-bg));
		border-radius: var(--radius-lg);
		color: var(--color-text-secondary);
	}

	.page-content :global(pre) {
		margin: 1.5em 0;
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.3em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}
</style>
