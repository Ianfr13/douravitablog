---
import Base from "../../layouts/Base.astro";
import "../../styles/tools.css";

const tools = [
	{
		href: "/blog/ferramentas/sarcopenia",
		category: "Quiz",
		title: "Você está em risco de sarcopenia?",
		meta: "6 perguntas · 1 min",
		desc: "Triagem baseada no SARC-F (validado). Resultado em 3 faixas: risco baixo, moderado ou alto.",
		icon: "clipboard",
		readAlso: {
			slug: "musculacao-depois-dos-55-o-guia-pra-comecar-do-zero",
			title: "Musculação depois dos 55: o guia pra começar do zero",
		},
	},
	{
		href: "/blog/ferramentas/imc-55",
		category: "Calculadora",
		title: "IMC ajustado para 55+",
		meta: "Idade, peso, altura · 10 segundos",
		desc: "Calcula seu IMC e usa a faixa saudável adaptada para idosos (22–27, não a clássica 18.5–24.9).",
		icon: "calculator",
		readAlso: {
			slug: "creatina-para-ganho-de-forca-em-maiores-de-55-anos",
			title: "Creatina para ganho de força em maiores de 55 anos",
		},
	},
	{
		href: "/blog/ferramentas/proteina-diaria",
		category: "Calculadora",
		title: "Proteína diária para 55+",
		meta: "Peso + nível de atividade · 10 segundos",
		desc: "Sua meta em gramas/dia + equivalente em ovos, frango, whey e outros alimentos.",
		icon: "calculator",
		readAlso: {
			slug: "whey-protein-funciona-para-ganhar-massa-muscular-aos-55",
			title: "Whey protein funciona para ganhar massa muscular aos 55",
		},
	},
	{
		href: "/blog/ferramentas/idade-biologica",
		category: "Calculadora",
		title: "Idade biológica vs cronológica",
		meta: "10 hábitos · 2 min",
		desc: "Combina 10 fatores de estilo de vida (sono, dieta, exercício, social...) e estima sua idade biológica.",
		icon: "calculator",
		readAlso: {
			slug: "idade-biologica-o-que-e-como-medir-em-casa-e-6-habitos-que-reduzem-5-anos",
			title: "Idade biológica: como medir em casa e 6 hábitos que reduzem 5+ anos",
		},
	},
];

const title = "Ferramentas para 55+";
const description =
	"Quiz, calculadoras e autoavaliações pensados pra quem tem 55+. Resultado em segundos, sem cadastro, sem login.";

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=60, stale-while-revalidate=86400",
);
---

<Base
	title={title}
	description={description}
	canonical={`${Astro.url.origin}/blog/ferramentas`}
>
	<div class="tools-index-page">
		<nav class="tool-breadcrumb" aria-label="Navegação estrutural">
			<a href="/blog">Blog</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">Ferramentas</span>
		</nav>

		<header class="tools-index-header">
			<h1 class="tools-index-title">Ferramentas para 55+</h1>
			<p class="tools-index-subtitle">
				Quiz, calculadoras e autoavaliações pensados pra quem tem 55+.
				Cada uma leva poucos minutos, dá resultado na hora e não pede
				cadastro nem login.
			</p>
		</header>

		<div class="tools-index-grid">
			{tools.map((t) => (
				<article class="tools-index-card">
					<a href={t.href} class="tools-index-card-main">
						<span class="tools-index-icon" aria-hidden="true">
							{t.icon === "clipboard" ? (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="4" width="18" height="16" rx="2"></rect>
									<path d="M9 9h6"></path>
									<path d="M9 13h6"></path>
									<path d="M9 17h3"></path>
								</svg>
							) : (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="4" y="2" width="16" height="20" rx="2"></rect>
									<line x1="8" y1="6" x2="16" y2="6"></line>
									<line x1="8" y1="10" x2="10" y2="10"></line>
									<line x1="14" y1="10" x2="16" y2="10"></line>
									<line x1="8" y1="14" x2="10" y2="14"></line>
									<line x1="14" y1="14" x2="16" y2="14"></line>
									<line x1="8" y1="18" x2="10" y2="18"></line>
									<line x1="14" y1="18" x2="16" y2="18"></line>
								</svg>
							)}
						</span>
						<div class="tools-index-body">
							<span class="tools-index-eyebrow">{t.category}</span>
							<h2 class="tools-index-card-title">{t.title}</h2>
							<p class="tools-index-desc">{t.desc}</p>
							<span class="tools-index-meta">{t.meta}</span>
						</div>
						<svg class="tools-index-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="5" y1="12" x2="19" y2="12"></line>
							<polyline points="12 5 19 12 12 19"></polyline>
						</svg>
					</a>
					{t.readAlso && (
						<a
							href={`/blog/posts/${t.readAlso.slug}`}
							class="tools-index-readalso"
						>
							<svg class="tools-index-readalso-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
								<path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
							</svg>
							<span class="tools-index-readalso-text">
								<span class="tools-index-readalso-label">Leia também:</span>
								<span class="tools-index-readalso-title">{t.readAlso.title}</span>
							</span>
							<svg class="tools-index-readalso-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
					)}
				</article>
			))}
		</div>

		<section class="tools-trust" aria-labelledby="tools-trust-title">
			<h2 id="tools-trust-title" class="tools-section-title">Por que confiar nessas ferramentas?</h2>
			<div class="tools-trust-grid">
				<div class="tools-trust-item">
					<div class="tools-trust-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
							<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
						</svg>
					</div>
					<h3 class="tools-trust-heading">Baseadas em ciência</h3>
					<p class="tools-trust-text">
						Cada ferramenta usa escalas validadas em literatura peer-reviewed
						— SARC-F (sarcopenia), PROT-AGE (proteína), Winter et al. 2014
						(IMC pós-65), Blue Zones e os hallmarks de Lopez-Otin (idade
						biológica).
					</p>
				</div>
				<div class="tools-trust-item">
					<div class="tools-trust-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
							<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
						</svg>
					</div>
					<h3 class="tools-trust-heading">Sem coleta de dados</h3>
					<p class="tools-trust-text">
						O cálculo acontece no seu navegador. Suas respostas não são
						salvas em servidor nenhum nem ligadas ao seu perfil — saem da
						tela quando você fechar a página.
					</p>
				</div>
				<div class="tools-trust-item">
					<div class="tools-trust-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20 6L9 17l-5-5"></path>
						</svg>
					</div>
					<h3 class="tools-trust-heading">Curadoria Douravita</h3>
					<p class="tools-trust-text">
						Revisadas pela nossa equipe editorial antes de irem ao ar.
						Não substituem um médico, mas dão um norte sério —
						com fontes citadas no rodapé de cada ferramenta.
					</p>
				</div>
			</div>
		</section>

		<section class="tools-upcoming" aria-labelledby="tools-upcoming-title">
			<h2 id="tools-upcoming-title" class="tools-section-title">Em breve</h2>
			<p class="tools-upcoming-subtitle">
				Próximas ferramentas que vamos lançar. Tem alguma que você gostaria
				de ver primeiro? Conta pra gente nos comentários de qualquer
				post.
			</p>
			<div class="tools-upcoming-grid">
				<div class="tools-upcoming-card">
					<span class="tools-upcoming-badge">Em breve</span>
					<h3 class="tools-upcoming-title">Quiz: você tem risco de osteoporose?</h3>
					<p class="tools-upcoming-desc">
						Triagem baseada em fatores validados (idade, menopausa precoce,
						IMC baixo, fumo, uso de corticoide, histórico familiar).
					</p>
				</div>
				<div class="tools-upcoming-card">
					<span class="tools-upcoming-badge">Em breve</span>
					<h3 class="tools-upcoming-title">Sua alimentação é mediterrânea?</h3>
					<p class="tools-upcoming-desc">
						10 perguntas sobre frequência de azeite, peixe, vegetais e
						leguminosas. Score + dicas práticas pra subir de faixa.
					</p>
				</div>
				<div class="tools-upcoming-card">
					<span class="tools-upcoming-badge">Em breve</span>
					<h3 class="tools-upcoming-title">Risco de queda em casa</h3>
					<p class="tools-upcoming-desc">
						Checklist híbrido: ambiente (tapete solto, iluminação, escada)
						+ corpo (tontura ao levantar, força nas pernas, visão).
					</p>
				</div>
			</div>
		</section>

		<aside class="tool-disclaimer">
			<p>
				Estas ferramentas são educativas, baseadas em literatura
				científica (SARC-F, PROT-AGE, Winter et al. 2014, Lifestyle
				Medicine). Não substituem avaliação médica individualizada.
				Em caso de dúvida sobre seu resultado, procure um
				nutricionista, geriatra ou seu médico de confiança.
			</p>
		</aside>
	</div>
</Base>

<style>
	.tools-index-page {
		max-width: 920px;
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.tools-index-header {
		margin-bottom: var(--spacing-8);
		max-width: 60ch;
	}

	.tools-index-title {
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-3);
		color: var(--color-text);
	}

	.tools-index-subtitle {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.tools-index-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-4);
	}

	@media (min-width: 720px) {
		.tools-index-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	/* Article container - holds main link + leia-tambem link */
	.tools-index-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
		border-radius: var(--radius-lg);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform var(--transition-fast),
			box-shadow var(--transition-fast),
			border-color var(--transition-fast);
	}

	.tools-index-card:has(.tools-index-card-main:hover),
	.tools-index-card:has(.tools-index-card-main:focus-visible) {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
		border-color: var(--color-accent);
	}

	/* Main link area: icon + body + arrow */
	.tools-index-card-main {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: var(--spacing-4);
		align-items: start;
		padding: var(--spacing-5);
		text-decoration: none;
		color: inherit;
		flex: 1;
	}

	.tools-index-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: var(--radius-md);
		background: rgba(0, 0, 0, 0.04);
		color: var(--color-accent);
		flex-shrink: 0;
	}

	.tools-index-icon svg {
		width: 24px;
		height: 24px;
	}

	.tools-index-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		min-width: 0;
	}

	.tools-index-eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-accent);
	}

	.tools-index-card-title {
		font-size: var(--font-size-lg);
		font-weight: 700;
		line-height: var(--leading-snug);
		color: var(--color-text);
		margin: 0;
	}

	.tools-index-desc {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin: 0;
	}

	.tools-index-meta {
		font-size: var(--font-size-xs);
		color: var(--color-text-muted, var(--color-text-secondary));
		font-weight: 500;
	}

	.tools-index-arrow {
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		color: var(--color-text-muted, var(--color-text-secondary));
		opacity: 0.5;
		align-self: center;
		transition: transform var(--transition-fast),
			opacity var(--transition-fast),
			color var(--transition-fast);
	}

	.tools-index-card-main:hover .tools-index-arrow,
	.tools-index-card-main:focus-visible .tools-index-arrow {
		transform: translateX(4px);
		opacity: 1;
		color: var(--color-accent);
	}

	/* "Leia também" footer link inside the card */
	.tools-index-readalso {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		padding: var(--spacing-3) var(--spacing-5);
		border-top: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
		background: color-mix(in srgb, var(--color-text) 4%, transparent);
		text-decoration: none;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		line-height: var(--leading-snug);
		transition: background var(--transition-fast),
			color var(--transition-fast);
	}

	.tools-index-readalso:hover,
	.tools-index-readalso:focus-visible {
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
		color: var(--color-text);
		outline: none;
	}

	.tools-index-readalso-icon {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
		color: var(--color-accent);
		opacity: 0.7;
	}

	.tools-index-readalso-text {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.tools-index-readalso-label {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-accent);
	}

	.tools-index-readalso-title {
		font-weight: 500;
		color: var(--color-text);
		line-height: var(--leading-snug);
	}

	.tools-index-readalso-arrow {
		flex-shrink: 0;
		width: 14px;
		height: 14px;
		opacity: 0.6;
		transition: transform var(--transition-fast),
			opacity var(--transition-fast);
	}

	.tools-index-readalso:hover .tools-index-readalso-arrow {
		transform: translateX(3px);
		opacity: 1;
	}

	/* ===== "Por que confiar" e "Em breve" sections ===== */
	.tools-section-title {
		font-size: clamp(1.5rem, 4vw, 2rem);
		font-weight: 700;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		margin: 0 0 var(--spacing-3);
	}

	.tools-trust {
		margin-top: var(--spacing-12);
	}

	.tools-trust-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-5);
		margin-top: var(--spacing-6);
	}

	@media (min-width: 720px) {
		.tools-trust-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--spacing-6);
		}
	}

	.tools-trust-item {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.tools-trust-icon {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-md);
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
		color: var(--color-accent);
	}

	.tools-trust-icon svg {
		width: 24px;
		height: 24px;
	}

	.tools-trust-heading {
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-text);
		margin: 0;
		line-height: var(--leading-snug);
	}

	.tools-trust-text {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin: 0;
	}

	.tools-upcoming {
		margin-top: var(--spacing-12);
	}

	.tools-upcoming-subtitle {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 60ch;
		margin: 0 0 var(--spacing-6);
	}

	.tools-upcoming-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-4);
	}

	@media (min-width: 720px) {
		.tools-upcoming-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.tools-upcoming-card {
		padding: var(--spacing-5);
		background: color-mix(in srgb, var(--color-text) 3%, transparent);
		border: 1px dashed var(--color-border, rgba(0, 0, 0, 0.15));
		border-radius: var(--radius-lg);
		opacity: 0.85;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.tools-upcoming-badge {
		display: inline-block;
		width: fit-content;
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		padding: 2px 8px;
		background: color-mix(in srgb, var(--color-accent) 18%, transparent);
		color: var(--color-accent);
		border-radius: 999px;
		margin-bottom: var(--spacing-1);
	}

	.tools-upcoming-title {
		font-size: var(--font-size-base);
		font-weight: 700;
		line-height: var(--leading-snug);
		color: var(--color-text);
		margin: 0;
	}

	.tools-upcoming-desc {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin: 0;
	}
</style>
