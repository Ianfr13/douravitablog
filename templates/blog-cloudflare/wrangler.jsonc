{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "douravitablog",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "douravitablog",
			"database_id": "cf53deb6-5330-4935-9549-ab0782ab8151",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "douravitablog",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "bdbbe6b193794f8dbcf6affa8bd702c3",
		},
	],
	"images": {
		"binding": "IMAGES",
	},
	// Comments / Reader Auth: site key publica do Turnstile (vai pro HTML).
	// Os secrets TURNSTILE_SECRET_KEY e READER_SESSION_SECRET vivem em
	// "encrypted secrets" do Worker (nao ficam aqui no repo).
	"vars": {
		"TURNSTILE_SITE_KEY": "0x4AAAAAADWzbE_A_uae235T",
	},
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Cron trigger pra pre-warm: roda o handler `scheduled` no worker.ts a cada
	// 1min, fazendo self-fetch nas URLs principais. Mantém o isolate quente
	// (~800ms de cold start eliminado) e caches.default sempre fresh.
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Smart Placement: CF roda o Worker no PoP mais proximo do D1/R2 (services
	// fixos geograficamente), em vez do PoP do usuario. Cada query no D1 que
	// custaria ~50ms cross-region cai pra ~5ms intra-region. Com 10-17 queries
	// por request, isso corta ~500-800ms do MISS. Trade: usuario tem +1 hop
	// pra chegar no Worker (~50ms), mas as queries salvam mais que isso.
	// CF analisa trafego por alguns minutos antes de aplicar a otimizacao.
	"placement": {
		"mode": "smart",
	},
	"routes": [
		{
			"pattern": "blog.douravita.com.br/*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/blog*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/posts*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/rss.xml",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/_emdash/*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/_astro/*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/pages/*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/pages",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/category/*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/categorias",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/tag/*",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/sitemap.xml",
			"zone_name": "douravita.com.br",
		},
		{
			"pattern": "douravita.com.br/fd04932e30993d72c654a14e55572025.txt",
			"zone_name": "douravita.com.br",
		},
	],
}
